disciplines: [[computer science]]
epistemology: applied sciences
equipment: laptop
needs: verify
project: TW-Base-Fields
role: guide
technology: TiddlyWiki Claude
title: Playground
type: text/vnd.tiddlywiki

\procedure pg-raw(value)
<%if [<value>!match[]] %><code><$text text=<<value>>/></code><%else%><em><<detect-language-lingo "Playground/Empty">></em><%endif%>
\end

\procedure pg-vocab-row(field)
<$let vocab={{{ [[$:/plugins/nikorion/base-fields/vocab/]addsuffix<field>] }}}
	value={{{ [<currentTiddler>get<field>] }}}
	shown={{{ [<currentTiddler>get<field>] :else[<vocab>get[blank-value]] }}}
>
<tr>
<td><code><$text text=<<field>>/></code></td>
<td><<pg-raw value=<<value>> >></td>
<td><%if [<field>match[needs]] %><$list filter="[enlist<value>]" variable="slug" join=", "><<bf-vocab-item field=<<field>> value=<<slug>> >></$list><%elseif [<shown>!match[]] %><<bf-vocab-item field=<<field>> value=<<shown>> >><%endif%></td>
</tr>
</$let>
\end

\procedure pg-text-row(field, list:"no")
<$let value={{{ [<currentTiddler>get<field>] }}}>
<tr>
<td><code><$text text=<<field>>/></code></td>
<td><<pg-raw value=<<value>> >></td>
<td><%if [<list>match[yes]] %><$list filter="[enlist<value>]" variable="item" join=" · "><$text text=<<item>>/></$list><%else%><$text text=<<value>>/><%endif%></td>
</tr>
</$let>
\end

