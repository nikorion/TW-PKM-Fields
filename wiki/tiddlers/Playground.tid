<td><%if [<slug>match<blankSlug>] %><em><<detect-language-lingo "Playground/Empty">></em><%else%><code><$text text=<<slug>>/></code><%endif%></td>
<td><$text text={{{ [function[bf-vocab-hint],<vocabField>,<slug>] }}}/></td>
</tr>
