\procedure pg-raw(value)
<%if [<value>!match[]] %><code><$text text=<<value>>/></code><%else%><em><<detect-language-lingo "Playground/Empty">></em><%endif%>
\end

\procedure pg-rendered(field, kind, value)
<%if [<kind>match[vocab]] %>
<$let shown={{{ [<value>!match[]] :else[function[pkm-vocab-blank],<field>] }}}>
<%if [<shown>!match[]] %><$transclude $variable="pkm-vocab-item" field=<<field>> value=<<shown>>/><%endif%>
</$let>
<%elseif [<kind>match[vocab-list]] %>
<$list filter="[enlist<value>]" variable="slug" join=", "><$transclude $variable="pkm-vocab-item" field=<<field>> value=<<slug>>/></$list>
<%elseif [<kind>match[list]] %>
<$list filter="[enlist<value>]" variable="item"><$transclude $variable="pkm-pill" field=<<field>> value=<<item>>/></$list>
<%else%>
<$text text=<<value>>/>
<%endif%>
\end

<<detect-language-lingo "Playground/Intro">>

<<detect-language-lingo "Playground/ValuesHeading" mode="block">>

<<detect-language-lingo "Playground/ValuesNote">>

<table><tbody>
<tr><th><<detect-language-lingo "Playground/Table1/Field">></th><th><<detect-language-lingo "Playground/Table1/RawValue">></th><th><<detect-language-lingo "Playground/Table1/Rendered">></th></tr>
<$list filter="[function[pkm-all-fields]]" variable="field">
<$let kind={{{ [function[pkm-field-kind],<field>] }}} value={{{ [<currentTiddler>get<field>] }}}>
<tr>
<td><$text text={{{ [function[pkm-field-label],<field>] }}}/> <code><$text text=<<field>>/></code></td>
<td><<pg-raw value=<<value>> >></td>
<td><<pg-rendered field=<<field>> kind=<<kind>> value=<<value>> >></td>
</tr>
</$let>
</$list>
</tbody></table>
