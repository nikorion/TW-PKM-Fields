title: $:/plugins/nikorion/pkm-fields/dyntable/styles
type: text/vnd.tiddlywiki

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/* vocabulary-list cell (e.g. `needs`, `deviation`): one value per line, in view mode (icon + label)
  as in edit mode (checkbox + icon + label), each kept whole */
td.nk-pkm-vocab-list .nk-pkm-value,
td .nk-check {
	display: block;
	white-space: nowrap;
}

/* a value stays on one line in a cell, in view and edit mode: a vocabulary value (icon + label), a free
  single value, each pill of a list (Dynamic Table puts one pill per line) */
.nk-pkm-value,
.nk-pkm-nowrap {
	white-space: nowrap;
}

/* a cell whose field does not apply to its record yet holds a value: framed in red, as the editor frames the control */
td.nk-pkm-stale {
	box-shadow: inset 0 0 0 2px <<colour alert-highlight>>;
	box-shadow: inset 0 0 0 2px color-mix(in srgb, <<colour alert-highlight>> 45%, transparent);
}

/*
	A single-value input in edit mode: the table squeezes its columns down to their content's
	narrowest width, which a percentage max-width or an input's own width do not hold. The
	control's box holds it instead: at least 12rem, or its placeholder if longer; the input
	fills it.
*/
td .nk-single-control {
	min-width: max(12rem, calc(var(--nk-input-chars, 12) * 1ch + 1.5em));
}

td .nk-single-control > .tc-keyboard {
	flex: 1 1 auto;
}

td .nk-single-control .nk-edit-input {
	width: 100%;
	max-width: none;
	box-sizing: border-box;
}
