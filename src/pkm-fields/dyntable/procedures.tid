title: $:/plugins/nikorion/pkm-fields/dyntable/procedures
type: text/vnd.tiddlywiki

<!--
	Table cells for the fields of the pkm schema, when Dynamic Table is installed: this
	plugin's templates plug into its extension points (tags `$:/tags/nk-dyntable/…`), so
	Dynamic Table itself knows nothing of the schema. Inert without Dynamic Table:
	nothing reads these tags then.

	A body template (dyntable/body/*) is picked by the field's `kind`, read from the
	schema through its `nk-dyntable-column-filter` — never by a list of field names, so a field
	added to the schema gets its column with nothing to change here. Each mirrors the
	editor's control for that kind:

	  kind         view                          edit
	  vocab        icon + label                  dropdown (blank value in place of "Select...")
	  vocab-list   icons + labels                one checkbox per value
	  list         pills, like tags              the editor's picker (nk-list-value-field)
	  date         the date, past ones greyed    the browser's date input
	  value        raw text, on one line         the editor's input and dropdown (nk-single-value-field)

	Three filters complete them: dyntable/column-label gives a field's label from the
	schema as its column header, dyntable/column-hint its description as the header's
	tooltip, dyntable/row-tones gives a record's tones (`pkm-tones`:
	`done` reads as success, `dropped` as muted, in the fields that apply to it) as the
	row classes `nk-dyntable-row-<tone>`, which Dynamic Table styles.

	What Dynamic Table hands a template (see its README, § Extending): `currentRecord`,
	`currentColumn`, the `tempTableEdit`/`tempTableSort` state tiddlers, the `dyntable-lingo*`
	strings and its cell classes.
-->

<!-- Choosing the blank value leaves an empty string: delete the field instead, as the editor does. -->
\procedure nk-pkm-clear-empty()
<$list filter="[<currentRecord>!has<currentColumn>]" variable="ignore">
<$action-deletefield $tiddler=<<currentRecord>> $field=<<currentColumn>>/>
</$list>
\end nk-pkm-clear-empty

<!-- vocab / vocab-list: icon + label of each stored value, the tooltip above. -->
\procedure nk-pkm-vocab-cell()
\whitespace trim
<$list filter="[<currentRecord>get<currentColumn>enlist-input[]]" variable="slug" join=", ">
<%if [function[nk-pkm-fresh]] %>
<span class="nk-pkm-value" title={{{ [function[pkm-vocab-tooltip],<currentColumn>,<slug>] }}}>
<$transclude $variable="pkm-vocab-item" field=<<currentColumn>> value=<<slug>>/>
</span>
<%else%>
<span class="nk-pkm-value"><$transclude $variable="pkm-vocab-item" field=<<currentColumn>> value=<<slug>>/></span>
<%endif%>
</$list>
\end nk-pkm-vocab-cell

\procedure nk-pkm-option(slug)
<option value={{{ [<slug>!match<blank>] }}} title={{{ [function[pkm-vocab-tooltip],<currentColumn>,<slug>] }}}><$transclude $variable="pkm-vocab-item" field=<<currentColumn>> value=<<slug>>/></option>
\end nk-pkm-option

<!--
	vocab: a dropdown, grouped like the editor's. A vocabulary with a blank value has no
	"Select..." option: its blank value //is// the empty field — its option carries "" and
	choosing it clears the field.
-->
\procedure nk-pkm-select()
<$let blank={{{ [function[pkm-vocab-blank],<currentColumn>] }}}>
<$select tiddler=<<currentRecord>> field=<<currentColumn>> default="" actions=<<nk-pkm-clear-empty>>>
<%if [<blank>match[]] %>
<option value=''><<dyntable-lingo "Tables/Select">></option>
<%endif%>
<$list filter="[function[pkm-vocab-ungrouped-values],<currentColumn>]" variable="slug">
<<nk-pkm-option slug=<<slug>> >>
</$list>
<$list filter="[function[pkm-vocab-groups],<currentColumn>]" variable="group">
<optgroup label={{{ [function[pkm-vocab-group-label],<currentColumn>,<group>] }}}>
<$list filter="[function[pkm-vocab-group-values],<currentColumn>,<group>]" variable="slug">
<<nk-pkm-option slug=<<slug>> >>
</$list>
</optgroup>
</$list>
</$select>
</$let>
\end nk-pkm-select

<!-- vocab-list: one checkbox per value (`listField` mode: ticking adds the slug, unticking removes it). -->
\procedure nk-pkm-checkboxes()
<$list filter="[function[pkm-vocab-values],<currentColumn>]" variable="slug">
<%if [function[nk-pkm-fresh]] %>
<span class="nk-pkm-check" title={{{ [function[pkm-vocab-tooltip],<currentColumn>,<slug>] }}}>
<$checkbox tiddler=<<currentRecord>> listField=<<currentColumn>> checked=<<slug>>>
<$transclude $variable="pkm-vocab-item" field=<<currentColumn>> value=<<slug>>/>
</$checkbox>
</span>
<%else%>
<span class="nk-pkm-check">
<$checkbox tiddler=<<currentRecord>> listField=<<currentColumn>> checked=<<slug>>>
<$transclude $variable="pkm-vocab-item" field=<<currentColumn>> value=<<slug>>/>
</$checkbox>
</span>
<%endif%>
</$list>
\end nk-pkm-checkboxes

<!-- list: the values as pills, each field with its own fallback colour. -->
\procedure nk-pkm-pills()
<$list filter="[<currentRecord>get<currentColumn>enlist-input[]]" variable="value">
<$transclude $variable="pkm-pill" field=<<currentColumn>> value=<<value>> tooltip={{{ [function[nk-pkm-fresh]then[yes]else[no]] }}}/>
</$list>
\end nk-pkm-pills

<!--
	list, edit mode: the editor's own picker (pills + input completing on the values already
	used), its input sized to its own placeholder (`ownWidth`). The picker qualifies its state tiddlers (input, selection, popup) with
	`transclusion`: one per record and column, or every row of the column would share a
	single input.
-->
\procedure nk-pkm-list-edit()
<$let currentTiddler=<<currentRecord>>
	transclusion={{{ [[dyntable/]addsuffix<currentRecord>addsuffix[/]addsuffix<currentColumn>] }}}
>
<$transclude $variable="nk-list-value-field" field=<<currentColumn>> ownWidth="yes"/>
</$let>
\end nk-pkm-list-edit

<!--
	A cell whose field does not apply to its record yet holds a value is flagged as in the
	editor (`pkm-is-stale`, `nk-stale-hint`): class `nk-pkm-stale`, the reason as its tooltip.
	As in the editor, the values inside it then have no tooltip of their own, which would hide
	the reason: `nk-pkm-fresh` is `fresh` only in a cell that is not flagged.
-->
\function nk-pkm-stale-class() [function[pkm-is-stale],<currentColumn>,<currentRecord>then[nk-pkm-stale]]
\function nk-pkm-stale-hint() [function[pkm-is-stale],<currentColumn>,<currentRecord>] :then[function[nk-stale-hint],<currentColumn>,<currentRecord>]
\function nk-pkm-fresh() [function[pkm-is-stale],<currentColumn>,<currentRecord>else[fresh]match[fresh]]

<!--
	value, edit mode: the editor's own control (input completing on the values already used,
	with their dropdown), without its label and delete button; one state per record and
	column (`transclusion`), as for a list.
-->
\procedure nk-pkm-value-edit()
<$let currentTiddler=<<currentRecord>>
	transclusion={{{ [[dyntable/]addsuffix<currentRecord>addsuffix[/]addsuffix<currentColumn>] }}}
>
<$transclude $variable="nk-single-value-field" field=<<currentColumn>> inCell="yes"/>
</$let>
\end nk-pkm-value-edit

<!-- the formatted date, the stored one as its tooltip — none in a flagged cell (see nk-pkm-fresh) -->
\procedure nk-pkm-date-text()
<%if [<actual>!match[]] %><span title=<<actual>>><$text text={{{ [<day>format:date<fmt>] }}}/></span><%else%><$text text={{{ [<day>format:date<fmt>] }}}/><%endif%>
\end nk-pkm-date-text

<!-- date: `YYYY-MM-DD` shown in the table's date format; a past date is greyed. -->
\procedure nk-pkm-date-cell()
<$let date-format=<<dyntable-lingo-text "Tables/Format/Date">>
	fmt=`[UTC]$(date-format)$`
	day={{{ [<currentRecord>get<currentColumn>split[-]join[]] }}}
	today=<<now YYYY0MM0DD>>
	actual={{{ [function[nk-pkm-fresh]] :then[<currentRecord>get<currentColumn>] :map[function[pkm-actual-value],<currentTiddler>] }}}
>
<%if [<day>regexp[^\d{8}$]compare:integer:lt<today>] %>
<span class="nk-dyntable-overdue"><<nk-pkm-date-text>></span>
<%elseif [<day>regexp[^\d{8}$]] %>
<<nk-pkm-date-text>>
<%else%>
<$text text={{{ [<currentRecord>get<currentColumn>] }}}/>
<%endif%>
</$let>
\end nk-pkm-date-cell

<!-- date, edit mode: the browser's date input, which writes `YYYY-MM-DD`; emptied, the field goes. -->
\procedure nk-pkm-date-edit()
<$edit-text tiddler=<<currentRecord>> field=<<currentColumn>> tag="input" type="date" default="" inputActions=<<nk-pkm-clear-empty>>/>
\end nk-pkm-date-edit
