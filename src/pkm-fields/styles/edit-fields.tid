title: $:/plugins/nikorion/pkm-fields/styles/edit-fields
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

/*
	The added controls form rows of their own, each placed relative to the core row
	it neighbours: Project, Epistemology, Closed regime, Deviation and Disciplines share
	the row right above the tags box (`list-before`), Technology and Equipment the row right after it
	(`list-after`), Role, Maturity, Lifecycle, Needs and Status the one under the
	type control. Placement is the `list-before`/`list-after`
	of each section — the stylesheet only lays out what is inside a row, so nothing
	here depends on the form's nesting and no core tiddler is overridden.

	Rows being independent matters: when the tags box grows a line, the row below
	moves down with it and nothing drifts sideways.
*/

.nk-extra-row {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 4px 16px;
	margin: 4px 0;
}

.nk-extra-row > * {
	min-width: 0;
}

/*
	Each list field takes the full width of its row; the next control sits on the
	line below. The input inside it carries the minimum room to type, and the box
	wraps its own pills internally once it runs out of row.
*/
.nk-pre-tags-extras > .nk-list-field,
.nk-post-tags-extras > .nk-list-field {
	align-self: stretch;
	max-width: 100%;
}

/* Role, Maturity, Status and Lifecycle: one select per line, stacked under the type control. */
.nk-type-extras,
.nk-pre-tags-extras,
.nk-post-tags-extras {
	flex-direction: column;
	align-items: flex-start;
}

/* The lines of the type row touch, like the rows of the core field table: no gap, more padding instead. */
.nk-type-extras {
	row-gap: 0;
	margin-bottom: 0;
}

/* A little air between the last custom line and the first core field row (instead of the core table's 1em). */
.nk-type-extras + .tc-edit-fields > table.tc-edit-fields {
	margin-top: 10px;
}

/* Role, the plain first line, keeps some air above the first band. */
.nk-type-extras > .nk-edit-field:first-child {
	margin-bottom: 10px;
}

/* Role, Maturity and Status: a label, a select, a clear button. */

.nk-edit-field {
	display: flex;
	align-items: center;
}

/*
	Every line of the type row below its first one (Role) spans the whole row and alternates
	its background like the field rows of the core editor below (odd / even colours, in
	order of appearance). Role, the first line, stays plain like the Type control above.
	Vertical padding is larger than the core's 4px; a red frame (3px, drawn inwards)
	takes 3px of it so the content does not move when it appears, and the frame lands
	on the edge of the band.
*/
.nk-type-extras > .nk-edit-field:nth-child(n+2) {
	align-self: stretch;
	box-sizing: border-box;
	padding: 6px 4px;
	background-color: <<colour tiddler-editor-fields-odd>>;
}

.nk-type-extras > .nk-edit-field:nth-child(n+3):nth-child(odd) {
	background-color: <<colour tiddler-editor-fields-even>>;
}

.nk-type-extras > .nk-edit-field.nk-stale:nth-child(n+2) {
	padding: 3px 1px;
}

.nk-edit-field > em {
	flex: 0 0 auto;
	margin-inline-end: 8px;
}

/* Labels read like the names of the core field rows below (plain text colour, not the muted one of `em.tc-edit`). */
.tc-tiddler-edit-frame .nk-edit-field > em.tc-edit {
	color: <<colour foreground>>;
}

.nk-edit-select {
	width: auto;
	max-width: 18em;
}

/*
	While the blank first option is the selected one, the select reads as a
	placeholder rather than as a value — and reads like the ones in the tools and
	tags inputs, which the browser draws itself: the text colour of the control,
	faded. `color-mix` reproduces that fade on the palette's own foreground, so the
	two match in every palette; `muted-foreground` stays as the value a browser
	without `color-mix` keeps. `:has()` is a progressive nicety: without it the hint
	simply shows in the normal text colour.
*/
.nk-edit-select:has(option[value=""]:checked) {
	color: <<colour muted-foreground>>;
	color: color-mix(in srgb, <<colour foreground>> 54%, transparent);
}

.nk-edit-select option {
	color: <<colour foreground>>;
}

/*
	Group headings inside the dropdown: a name over the values it gathers, not
	something to pick. Greyed and unemphasised so it reads as a divider rather than
	as an entry; the rule above keeps the values themselves at full contrast.
*/
.nk-edit-select optgroup {
	color: <<colour muted-foreground>>;
	font-weight: normal;
	font-style: italic;
}

/* Maturity and Lifecycle: radio buttons side by side, wrapping when the row is short. */
.nk-radio-group {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 2px 14px;
}

.nk-radio-group .tc-radio {
	white-space: nowrap;
}

/* The "none" value (empty field) reads as an absence of value. */
.nk-vocab-none {
	font-style: italic;
}

/* A space between the radio button or checkbox and the icon that starts the value. */
.nk-radio-group .tc-radio > span,
.nk-checkbox-field .tc-checkbox > span {
	margin-inline-start: 0.4em;
}

.nk-delete-field {
	flex: 0 0 auto;
	padding: 0 2px;
}

/* After radios or checkboxes the clear button is set well apart from the last choice. */
.nk-edit-field:has(.nk-radio-group) > .nk-delete-field,
.nk-checkbox-field > .nk-delete-field {
	margin-inline-start: 24px;
}

/* After a dropdown a smaller gap is enough. */
.nk-edit-field:has(.nk-edit-select) > .nk-delete-field {
	margin-inline-start: 6px;
}

.nk-single-control + .nk-delete-field,
.nk-edit-date + .nk-delete-field {
	margin-inline-start: 6px;
}

/* Due: the browser's own date input, as wide as a date. */
.nk-edit-date {
	width: auto;
}

/* Project: one value, typed or picked, so the input is sized for a name. */

.nk-single-control {
	display: flex;
	align-items: center;
	position: relative;
}

/*
	A single-value input is as wide as its placeholder (`--nk-input-chars`, set by the
	macro from the current language's string), so it always reads in full.
*/
.nk-single-control .nk-edit-input {
	width: calc(var(--nk-input-chars, 12) * 1ch + 1.5em);
	max-width: 100%;
}

/*
	A list field's input shares a one-cell grid with a hidden copy of the text it is sized
	to (`nk-input-sizer`, carrying the input's own class so its font, padding and border
	match): the cell takes that text's real width, in any browser and language, and the
	input fills the cell. The sizer keeps its width but not its height. The selectors
	outweigh the core's `.tc-edit-add-tag .tc-add-tag-name input { width: 50% }` and a
	table's own layout of the picker, whatever the order of the stylesheets.
*/
.nk-list-field .tc-edit-add-tag .tc-add-tag-name {
	display: inline-grid;
	vertical-align: middle;
}

/*
	The theme pads and borders only an `input.tc-edit-texteditor`: both get the same
	horizontal padding and border here, so the sizer measures what the input needs.
*/
.nk-list-field .tc-edit-add-tag .tc-add-tag-name > * {
	grid-area: 1 / 1;
}

.nk-list-field .tc-edit-add-tag .tc-add-tag-name input,
.nk-list-field .tc-edit-add-tag .nk-input-sizer {
	padding-left: 3px;
	padding-right: 3px;
	border-left: 1px solid;
	border-right: 1px solid;
}

.nk-list-field .tc-edit-add-tag .tc-add-tag-name input {
	border-color: <<colour tiddler-editor-border>>;
}

/* `width: 0` so the input's own default width (about twenty characters) does not size the cell; `min-width` then fills it. */
.nk-list-field .tc-edit-add-tag .tc-add-tag-name input {
	width: 0;
	min-width: 100%;
	max-width: none;
	box-sizing: border-box;
}

.nk-list-field .tc-edit-add-tag .nk-input-sizer {
	display: block;
	visibility: hidden;
	border-color: transparent;
	height: 0;
	padding-top: 0;
	padding-bottom: 0;
	border-top-width: 0;
	border-bottom-width: 0;
	overflow: hidden;
	white-space: pre;
	box-sizing: border-box;
}

/* A label with an explanation to give: shown as a tooltip, flagged by the cursor. */
.nk-edit-field > em[title]:not([title=""]) {
	cursor: help;
	text-decoration: underline dotted;
}

/* The dropdown arrow sits apart from the input rather than against it. */
.nk-single-control .tc-btn-dropdown {
	margin-inline-start: 8px;
}

/* Drop the suggestions right under the input rather than after the flex row. */
.nk-single-control .tc-block-dropdown-wrapper {
	position: absolute;
	top: 100%;
	left: 0;
	right: 0;
	z-index: 1000;
}

.nk-dropdown-item {
	display: block;
	width: 100%;
	text-align: left;
	padding: 3px 14px;
	color: <<colour foreground>>;
}

.nk-dropdown-item:hover {
	background-color: <<colour dropdown-background>>;
	color: <<colour foreground>>;
	text-decoration: none;
}

/* Technology, Equipment, Disciplines: a tags-style box, so the pills and the picker come styled by the core. */

.nk-list-field {
	display: flex;
}

.nk-list-field .nk-list-box {
	flex: 1 1 auto;
}

/*
	The core sizes the tag input at `width: 50%` of the tags box — right when the box
	spans the row, but here the box is sized by the input, so half of it would stay
	empty and push the next control away. The input gets a width of its own instead
	(see the single-value inputs above).
*/

/*
	A control shown only because its field still holds a value although the field does
	not apply to the tiddler (its role changed since): framed in red to say the value
	should go.
*/
.nk-edit-field.nk-stale,
.nk-list-field.nk-stale {
	border: 3px solid <<colour alert-highlight>>;
	border-color: color-mix(in srgb, <<colour alert-highlight>> 45%, transparent);
	padding: 0 4px;
}

/*
	A vocabulary list field (Needs): a label, one checkbox per value, a clear button,
	all on one line that wraps once the row runs out of width.
*/
.nk-checkbox-field {
	flex-wrap: wrap;
	gap: 4px 12px;
}

.nk-checkbox-field .nk-check {
	white-space: nowrap;
}
