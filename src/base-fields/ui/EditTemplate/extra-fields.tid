title: $:/plugins/nikorion/base-fields/ui/EditTemplate/extra-fields
tags: $:/tags/EditTemplate
list-after: $:/core/ui/EditTemplate/tags
type: text/vnd.tiddlywiki

\whitespace trim

<!--
	Tools then Project, each on a row of its own right under the tags box:
	`list-after` puts the section there, so the rows stay independent — the tags box
	can grow all the lines it likes, and the tools box too, without moving anything
	below sideways.
-->

<div class="bf-extra-row bf-tags-extras">
<$transclude $variable="bf-tools-field"/>
</div>

<div class="bf-extra-row bf-project-row">
<$transclude $variable="bf-project-field"/>
</div>
