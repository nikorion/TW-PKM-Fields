title: $:/plugins/nikorion/base-fields/ui/EditTemplate/extra-fields
tags: $:/tags/EditTemplate
list-after: $:/core/ui/EditTemplate/tags
type: text/vnd.tiddlywiki

\whitespace trim

<!--
	Tools and Project, meant to sit beside the tags box. Being a section of their
	own they are a block the stylesheet can place in the row the tags box occupies,
	which is how they share that row without any core tiddler being overridden.
-->

<div class="bf-extra-row bf-tags-extras">
<$transclude $variable="bf-tools-field"/>
<$transclude $variable="bf-project-field"/>
</div>
