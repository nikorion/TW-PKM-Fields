title: $:/plugins/nikorion/base-fields/ui/EditTemplate/extra-fields
tags: $:/tags/EditTemplate
list-after: $:/core/ui/EditTemplate/tags
type: text/vnd.tiddlywiki

\whitespace trim

<!--
	The row right under the tags box (`list-after` puts the section there, so the row
	stays independent: the tags box above can grow all the lines it likes without moving
	anything here sideways): the fields of `$:/config/nikorion/base-fields/row/post-tags`
	— Technology and Equipment out of the box — then any free field of the ontology that
	no row names.
-->

<%if [function[bf-row-fields],[post-tags]] :else[function[bf-unplaced-free-fields]] %>
<div class="bf-extra-row bf-post-tags-extras">
<$list filter="[function[bf-row-fields],[post-tags]] [function[bf-unplaced-free-fields]]" variable="field">
<<bf-field field=<<field>> >>
</$list>
</div>
<%endif%>
