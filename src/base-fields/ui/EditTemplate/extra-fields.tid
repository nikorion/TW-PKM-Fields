title: $:/plugins/nikorion/base-fields/ui/EditTemplate/extra-fields
tags: $:/tags/EditTemplate
list-after: $:/core/ui/EditTemplate/tags
type: text/vnd.tiddlywiki

\whitespace trim

<!--
	Tools and Project, on a row of their own right under the tags box: `list-after`
	puts the section there, so the two rows stay independent — the tags box can grow
	all the lines it likes without moving anything here sideways.
-->

<div class="bf-extra-row bf-tags-extras">
<$transclude $variable="bf-tools-field"/>
<$transclude $variable="bf-project-field"/>
</div>
