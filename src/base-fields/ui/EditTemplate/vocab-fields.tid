title: $:/plugins/nikorion/base-fields/ui/EditTemplate/vocab-fields
tags: $:/tags/EditTemplate
list-after: $:/core/ui/EditTemplate/type
type: text/vnd.tiddlywiki

\whitespace trim

<!--
	The row right under the type control, one line per field: the fields of
	`$:/config/nikorion/base-fields/row/type` — Role, Maturity, Lifecycle, Needs and
	Status out of the box — then any vocabulary field of the ontology that no row names.

	Which tiddlers a field applies to is not decided here but by the ontology
	(`applies-filter` of the field's definition): `bf-field` leaves the field out where it
	does not apply, unless it holds a value — then it is shown framed in red.
-->

<div class="bf-extra-row bf-type-extras">
<$list filter="[function[bf-row-fields],[type]] [function[bf-unplaced-vocab-fields]]" variable="field">
<<bf-field field=<<field>> >>
</$list>
</div>
