title: $:/plugins/nikorion/base-fields/ui/EditTemplate/vocab-fields
tags: $:/tags/EditTemplate
list-after: $:/core/ui/EditTemplate/type
type: text/vnd.tiddlywiki

\whitespace trim

<!--
	Role, Maturity and Status, placed beside the type control by the stylesheet.

	Status only appears on tiddlers where it means something — how far along a piece
	of work is, on a tiddler that is a piece of work. Which roles those are is not
	decided here but on the vocabulary itself, in its `visible-filter` field, so that
	the rule sits next to the values it governs.

	It also appears whenever the field already holds a value, whatever the role. A
	tiddler that was a task and became something else keeps its `status` until
	someone clears it; hiding the control would leave that value invisible in the
	editor yet still matched by filters, and with no way to remove it.
-->

<div class="bf-extra-row bf-type-extras">
<$transclude $variable="bf-select-field" field="role"/>
<$transclude $variable="bf-select-field" field="maturity"/>
<$let statusWhen={{$:/plugins/nikorion/base-fields/vocab/status!!visible-filter}}>
<%if [subfilter<statusWhen>] [<currentTiddler>has[status]] %>
<$transclude $variable="bf-select-field" field="status"/>
<%endif%>
</$let>
</div>
