title: $:/plugins/nikorion/base-fields/readme/controls
type: text/vnd.tiddlywiki

\whitespace trim

<!-- The readme's table of controls, generated from the ontology and the control config, so it never lags behind. -->

<table>
<thead>
<tr>
<th><<base-fields-lingo Readme/Column/Field>></th>
<th><<base-fields-lingo Readme/Column/Control>></th>
</tr>
</thead>
<tbody>
<$list filter="[function[kms-fields]]" variable="field">
<$let kind={{{ [function[kms-field-kind],<field>] }}}
	control={{{ [[$:/config/nikorion/base-fields/control/]addsuffix<field>get[text]match[radio]then[vocab-radio]] :else[<kind>] }}}
>
<tr>
<td><$text text={{{ [function[kms-field-label],<field>] }}}/></td>
<td><$text text={{{ [[Readme/Control/]addsuffix<control>] :map[function[base-fields-lingo-text],<currentTiddler>] }}}/></td>
</tr>
</$let>
</$list>
</tbody>
</table>
