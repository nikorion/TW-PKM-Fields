title: $:/plugins/nikorion/base-fields/vocabularies
type: text/vnd.tiddlywiki
caption: <<base-fields-lingo Vocabularies/Caption>>

\whitespace trim

<$transclude $variable="base-fields-lingo" title="Vocabularies/Intro" $mode="block"/>

<$list filter="nature status" variable="vocabField">

<!-- The form label carries its own punctuation ("Nature :"), which a heading does not want. -->
<$let promptKey={{{ [[Fields/]addsuffix<vocabField>addsuffix[/Prompt]] }}}>
<h2><$text text={{{ [function[base-fields-lingo-text],<promptKey>trim[:]trim[]] }}}/><$text text=" "/><code><$text text=<<vocabField>>/></code></h2>
</$let>

<table class="bf-vocab-table">
<thead>
<tr>
<th><$transclude $variable="base-fields-lingo" title="Vocabularies/Column/Value"/></th>
<th><$transclude $variable="base-fields-lingo" title="Vocabularies/Column/Stored"/></th>
<th><$transclude $variable="base-fields-lingo" title="Vocabularies/Column/Meaning"/></th>
</tr>
</thead>
<tbody>
<$list filter="[function[bf-vocab-values],<vocabField>]" variable="slug">
<tr>
<td><$transclude $variable="bf-vocab-item" field=<<vocabField>> value=<<slug>>/></td>
<td><code><$text text=<<slug>>/></code></td>
<td><$text text={{{ [function[bf-vocab-hint],<vocabField>,<slug>] }}}/></td>
</tr>
</$list>
</tbody>
</table>

</$list>

<$transclude $variable="base-fields-lingo" title="Vocabularies/Outro" $mode="block"/>
