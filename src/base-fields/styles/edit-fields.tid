title: $:/plugins/nikorion/base-fields/styles/edit-fields
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

/*
	The added controls form rows of their own, each placed relative to the core row
	it neighbours: Project, Epistemology and Disciplines share the row right above
	the tags box (`list-before`), Technology and Equipment the row right after it
	(`list-after`), Role, Maturity, Lifecycle, Needs and Status the one under the
	type control. Placement is the `list-before`/`list-after`
	of each section — the stylesheet only lays out what is inside a row, so nothing
	here depends on the form's nesting and no core tiddler is overridden.

	Rows being independent matters: when the tags box grows a line, the row below
	moves down with it and nothing drifts sideways.
*/

.bf-extra-row {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 4px 16px;
	margin: 4px 0;
}

.bf-extra-row > * {
	min-width: 0;
}

/*
	Each list field takes the full width of its row; the next control sits on the
	line below. The input inside it carries the minimum room to type, and the box
	wraps its own pills internally once it runs out of row.
*/
.bf-pre-tags-extras > .bf-list-field,
.bf-post-tags-extras > .bf-list-field {
	align-self: stretch;
	max-width: 100%;
}

/* Role, Maturity, Status and Lifecycle: one select per line, stacked under the type control. */
.bf-type-extras,
.bf-pre-tags-extras,
.bf-post-tags-extras {
	flex-direction: column;
	align-items: flex-start;
}

/* The lines of the type and needs rows touch, like the rows of the core field table: no gap, more padding instead. */
.bf-type-extras {
	row-gap: 0;
	margin-bottom: 0;
}

/* A little air between the last custom line and the first core field row (instead of the core table's 1em). */
.bf-type-extras + .tc-edit-fields > table.tc-edit-fields {
	margin-top: 10px;
}

/* Role, the plain first line, keeps some air above the first band. */
.bf-type-extras > .bf-edit-field:first-child {
	margin-bottom: 10px;
}

/* Role, Maturity and Status: a label, a select, a clear button. */

.bf-edit-field {
	display: flex;
	align-items: center;
}

/*
	Every line of the type and needs rows below Role spans the whole row and alternates
	its background like the field rows of the core editor below (odd / even colours, in
	order of appearance). Role, the first line, stays plain like the Type control above.
	Vertical padding is larger than the core's 4px; a red frame (3px, drawn inwards)
	takes 3px of it so the content does not move when it appears, and the frame lands
	on the edge of the band.
*/
.bf-type-extras > .bf-edit-field:nth-child(n+2) {
	align-self: stretch;
	box-sizing: border-box;
	padding: 6px 4px;
	background-color: <<colour tiddler-editor-fields-odd>>;
}

.bf-type-extras > .bf-edit-field:nth-child(n+3):nth-child(odd) {
	background-color: <<colour tiddler-editor-fields-even>>;
}

.bf-type-extras > .bf-edit-field.bf-stale:nth-child(n+2) {
	padding: 3px 1px;
}

.bf-edit-field > em {
	flex: 0 0 auto;
	margin-inline-end: 8px;
}

/* Labels read like the names of the core field rows below (plain text colour, not the muted one of `em.tc-edit`). */
.tc-tiddler-edit-frame .bf-edit-field > em.tc-edit {
	color: <<colour foreground>>;
}

.bf-edit-select {
	width: auto;
	max-width: 18em;
}

/*
	While the blank first option is the selected one, the select reads as a
	placeholder rather than as a value — and reads like the ones in the tools and
	tags inputs, which the browser draws itself: the text colour of the control,
	faded. `color-mix` reproduces that fade on the palette's own foreground, so the
	two match in every palette; `muted-foreground` stays as the value a browser
	without `color-mix` keeps. `:has()` is a progressive nicety: without it the hint
	simply shows in the normal text colour.
*/
.bf-edit-select:has(option[value=""]:checked) {
	color: <<colour muted-foreground>>;
	color: color-mix(in srgb, <<colour foreground>> 54%, transparent);
}

.bf-edit-select option {
	color: <<colour foreground>>;
}

/*
	Group headings inside the dropdown: a name over the values it gathers, not
	something to pick. Greyed and unemphasised so it reads as a divider rather than
	as an entry; the rule above keeps the values themselves at full contrast.
*/
.bf-edit-select optgroup {
	color: <<colour muted-foreground>>;
	font-weight: normal;
	font-style: italic;
}

/* Maturity and Lifecycle: radio buttons side by side, wrapping when the row is short. */
.bf-radio-group {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 2px 14px;
}

.bf-radio-group .tc-radio {
	white-space: nowrap;
}

/* The "none" value (empty field) reads as an absence of value. */
.bf-vocab-none {
	font-style: italic;
}

/* A space between the radio button or checkbox and the icon that starts the value. */
.bf-radio-group .tc-radio > span,
.bf-needs-field .tc-checkbox > span {
	margin-inline-start: 0.4em;
}

.bf-delete-field {
	flex: 0 0 auto;
	padding: 0 2px;
}

/* After radios or checkboxes the clear button is set well apart from the last choice. */
.bf-edit-field:has(.bf-radio-group) > .bf-delete-field,
.bf-needs-field > .bf-delete-field {
	margin-inline-start: 24px;
}

/* After a dropdown a smaller gap is enough. */
.bf-edit-field:has(.bf-edit-select) > .bf-delete-field {
	margin-inline-start: 6px;
}

.bf-single-control + .bf-delete-field {
	margin-inline-start: 6px;
}

/* Project, Epistemology: one value, typed or picked, so the input is sized for a name. */

.bf-single-control {
	display: flex;
	align-items: center;
	position: relative;
}

/*
	Inputs are as wide as their placeholder (`--bf-input-chars`, set by the macro from
	the current language's string), so it always reads in full.
*/
.bf-single-control .bf-edit-input,
.bf-list-field .tc-add-tag-name input {
	width: calc(var(--bf-input-chars, 12) * 1ch + 1.5em);
	max-width: 100%;
}

/* A label with an explanation to give: shown as a tooltip, flagged by the cursor. */
.bf-edit-field > em[title]:not([title=""]) {
	cursor: help;
	text-decoration: underline dotted;
}

/* The dropdown arrow sits apart from the input rather than against it. */
.bf-single-control .tc-btn-dropdown {
	margin-inline-start: 8px;
}

/* Drop the suggestions right under the input rather than after the flex row. */
.bf-single-control .tc-block-dropdown-wrapper {
	position: absolute;
	top: 100%;
	left: 0;
	right: 0;
	z-index: 1000;
}

.bf-dropdown-item {
	display: block;
	width: 100%;
	text-align: left;
	padding: 3px 14px;
	color: <<colour foreground>>;
}

.bf-dropdown-item:hover {
	background-color: <<colour dropdown-background>>;
	color: <<colour foreground>>;
	text-decoration: none;
}

/* Technology, Equipment, Disciplines: a tags-style box, so the pills and the picker come styled by the core. */

.bf-list-field {
	display: flex;
}

.bf-list-field .bf-list-box {
	flex: 1 1 auto;
}

/*
	The core sizes the tag input at `width: 50%` of the tags box — right when the box
	spans the row, but here the box is sized by the input, so half of it would stay
	empty and push the next control away. The input gets a width of its own instead
	(see the single-value inputs above).
*/

/*
	A control shown only because its field still holds a value the role no longer
	accounts for: framed in red to say the value should go.
*/
.bf-edit-field.bf-stale {
	border: 3px solid <<colour alert-highlight>>;
	border-color: color-mix(in srgb, <<colour alert-highlight>> 45%, transparent);
	padding: 0 4px;
}

/*
	Needs: a label, one checkbox per value, a clear button, all on one line that
	wraps once the row runs out of width.
*/
.bf-needs-field {
	flex-wrap: wrap;
	gap: 4px 12px;
}

.bf-needs-field .bf-need {
	white-space: nowrap;
}
