title: $:/plugins/nikorion/base-fields/styles/edit-fields
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

/*
	The added controls form rows of their own, each one right under the core row it
	extends: Tools and Project under the tags box, Role, Maturity and Status under the
	type control. Placement is the `list-after` of each section — the stylesheet only
	lays out what is inside a row, so nothing here depends on the form's nesting and
	no core tiddler is overridden.

	Rows being independent matters: when the tags box grows a line, the row below
	moves down with it and nothing drifts sideways.
*/

.bf-extra-row {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 4px 16px;
	margin: 4px 0;
}

.bf-extra-row > * {
	min-width: 0;
}

/*
	The tools box takes the width the row has to give, exactly as the tags box does
	above it: its pills then flow on the same line as its input and wrap inside it,
	rather than piling up above. Project keeps its natural width at the far end, where
	it stays put however many tools are added.
*/
.bf-tags-extras > .bf-tools-field {
	flex: 1 1 12em;
}

.bf-tags-extras > .bf-edit-field-project {
	flex: 0 0 auto;
}

/* Role, Maturity and Status read as text: line up on the text, not on the boxes. */
.bf-type-extras {
	align-items: baseline;
}

/* Role, Maturity and Status: a label, a select, a clear button. */

.bf-edit-field {
	display: flex;
	align-items: center;
}

.bf-edit-field > em {
	flex: 0 0 auto;
	margin-inline-end: 8px;
}

.bf-edit-select {
	width: auto;
	max-width: 18em;
}

/*
	While the blank first option is the selected one, the select reads as a
	placeholder rather than as a value. `:has()` is a progressive nicety: without it
	the hint simply shows in the normal text colour.
*/
.bf-edit-select:has(option[value=""]:checked) {
	color: <<colour muted-foreground>>;
}

.bf-edit-select option {
	color: <<colour foreground>>;
}

.bf-delete-field {
	flex: 0 0 auto;
	padding: 0 2px;
}

/* Project: one value, typed or picked, so the input is sized for a name. */

.bf-project-control {
	display: flex;
	align-items: center;
	position: relative;
}

.bf-project-control .bf-edit-input {
	width: 12em;
}

/* Drop the suggestions right under the input rather than after the flex row. */
.bf-project-control .tc-block-dropdown-wrapper {
	position: absolute;
	top: 100%;
	left: 0;
	right: 0;
	z-index: 1000;
}

.bf-dropdown-item {
	display: block;
	width: 100%;
	text-align: left;
	padding: 3px 14px;
	color: <<colour foreground>>;
}

.bf-dropdown-item:hover {
	background-color: <<colour dropdown-background>>;
	color: <<colour foreground>>;
	text-decoration: none;
}

/* Tools: a tags-style box, so the pills and the picker come styled by the core. */

.bf-tools-field {
	display: flex;
}

.bf-tools-field .bf-tools-box {
	flex: 1 1 auto;
	min-width: 12em;
}
