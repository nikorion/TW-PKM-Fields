title: $:/plugins/nikorion/base-fields/styles/edit-fields
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

/*
	The Type row becomes a single flex line carrying Type, Nature, Status and
	Project. Every control shares the width evenly and is allowed to shrink, so the
	row always fits inside the tiddler; below a readable floor it wraps onto a
	second line rather than squeezing the controls into nothing.
*/

.tc-edit-type-selector-wrapper {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 4px 8px;
}

.tc-edit-type-selector-wrapper > em {
	flex: 0 0 auto;
}

/*
	`10em` is the readable floor of a control: the four of them share whatever room
	is left, evenly, and wrap once they no longer fit. It also overrides the core
	min-width computed from the longest type name (`set-type-selector-min-width`),
	which would otherwise keep the type control from shrinking at all.
*/
.tc-edit-type-selector-wrapper > .tc-type-selector-dropdown-wrapper,
.tc-edit-type-selector-wrapper > .bf-edit-field {
	flex: 1 1 10em;
	min-width: 10em;
}

.tc-edit-type-selector-wrapper .tc-type-selector-dropdown-wrapper input.tc-edit-typeeditor {
	min-width: 0;
}

.tc-edit-type-selector-wrapper .tc-type-selector {
	display: flex;
	align-items: center;
}

.tc-edit-type-selector-wrapper .tc-type-selector .tc-edit-typeeditor {
	flex: 1 1 0;
	min-width: 0;
	width: 100%;
}

.bf-edit-field {
	display: flex;
	align-items: center;
	min-width: 0;
}

.bf-edit-field > em {
	flex: 0 0 auto;
}

.bf-edit-field .bf-edit-select,
.bf-edit-field .bf-edit-input {
	flex: 1 1 0;
	min-width: 0;
	width: 100%;
	box-sizing: border-box;
}

.bf-project-control {
	display: flex;
	align-items: center;
	flex: 1 1 0;
	min-width: 0;
	position: relative;
}

/* Drop the suggestions right under the input rather than after the flex row. */
.bf-project-control .tc-block-dropdown-wrapper {
	position: absolute;
	top: 100%;
	left: 0;
	right: 0;
	z-index: 1000;
}

.bf-project-dropdown .bf-dropdown-item {
	display: block;
	width: 100%;
	text-align: left;
	padding: 3px 14px;
	color: <<colour foreground>>;
}

.bf-project-dropdown .bf-dropdown-item:hover {
	background-color: <<colour dropdown-background>>;
	color: <<colour foreground>>;
	text-decoration: none;
}

/*
	Tags and Tools share one row without either being a core override: the edit
	template renders its sections as siblings of one anonymous container, so that
	container becomes a two-column grid. Every section spans both columns except
	the tags box and the tools box, which take one each.
*/

.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	align-items: start;
	column-gap: 8px;
}

.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > * {
	grid-column: 1 / -1;
	min-width: 0;
}

.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > .tc-edit-tags {
	grid-column: 1;
}

.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > .bf-tools-field {
	grid-column: 2;
}

/* Too narrow for two columns: each box takes the full width again. */
@media (max-width: 1000px) {
	.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > .tc-edit-tags,
	.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > .bf-tools-field {
		grid-column: 1 / -1;
	}
}

.bf-tools-field {
	display: flex;
	align-items: flex-start;
}

.bf-tools-field > em {
	flex: 0 0 auto;
	padding-top: 6px;
}

.bf-tools-field .bf-tools-box {
	flex: 1 1 auto;
	min-width: 0;
}

.bf-tool-label {
	display: inline-block;
	background-color: <<colour tag-background>>;
	color: <<colour tag-foreground>>;
	fill: <<colour tag-foreground>>;
}
