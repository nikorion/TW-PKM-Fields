title: $:/plugins/nikorion/base-fields/styles/edit-fields
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

/*
	The added controls form rows of their own, each one right under the core row it
	extends: Tools and Project share the row under the tags box, Role, Maturity and
	Status the one under the type control. Placement is the `list-after` of each section — the stylesheet only
	lays out what is inside a row, so nothing here depends on the form's nesting and
	no core tiddler is overridden.

	Rows being independent matters: when the tags box grows a line, the row below
	moves down with it and nothing drifts sideways.
*/

.bf-extra-row {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 4px 16px;
	margin: 4px 0;
}

.bf-extra-row > * {
	min-width: 0;
}

/*
	The tools box grows with its pills and stops there, so Project sits straight after
	it rather than at the far edge of the row. The input inside it carries the minimum
	room to type; the box still wraps its own pills internally once it runs out of
	row, and Project then falls to the line below.
*/
.bf-tags-extras > .bf-tools-field {
	flex: 0 1 auto;
	max-width: 100%;
}

/* Role, Maturity and Status read as text: line up on the text, not on the boxes. */
.bf-type-extras {
	align-items: baseline;
}

/* Role, Maturity and Status: a label, a select, a clear button. */

.bf-edit-field {
	display: flex;
	align-items: center;
}

.bf-edit-field > em {
	flex: 0 0 auto;
	margin-inline-end: 8px;
}

.bf-edit-select {
	width: auto;
	max-width: 18em;
}

/*
	While the blank first option is the selected one, the select reads as a
	placeholder rather than as a value — and reads like the ones in the tools and
	tags inputs, which the browser draws itself: the text colour of the control,
	faded. `color-mix` reproduces that fade on the palette's own foreground, so the
	two match in every palette; `muted-foreground` stays as the value a browser
	without `color-mix` keeps. `:has()` is a progressive nicety: without it the hint
	simply shows in the normal text colour.
*/
.bf-edit-select:has(option[value=""]:checked) {
	color: <<colour muted-foreground>>;
	color: color-mix(in srgb, <<colour foreground>> 54%, transparent);
}

.bf-edit-select option {
	color: <<colour foreground>>;
}

.bf-delete-field {
	flex: 0 0 auto;
	padding: 0 2px;
}

/* Project: one value, typed or picked, so the input is sized for a name. */

.bf-project-control {
	display: flex;
	align-items: center;
	position: relative;
}

.bf-project-control .bf-edit-input {
	width: 12em;
}

/* Drop the suggestions right under the input rather than after the flex row. */
.bf-project-control .tc-block-dropdown-wrapper {
	position: absolute;
	top: 100%;
	left: 0;
	right: 0;
	z-index: 1000;
}

.bf-dropdown-item {
	display: block;
	width: 100%;
	text-align: left;
	padding: 3px 14px;
	color: <<colour foreground>>;
}

.bf-dropdown-item:hover {
	background-color: <<colour dropdown-background>>;
	color: <<colour foreground>>;
	text-decoration: none;
}

/* Tools: a tags-style box, so the pills and the picker come styled by the core. */

.bf-tools-field {
	display: flex;
}

.bf-tools-field .bf-tools-box {
	flex: 0 1 auto;
}

/*
	The core sizes the tag input at `width: 50%` of the tags box — right when the box
	spans the row, but here the box is sized by the input, so half of it would stay
	empty and push Project away. A width of its own makes the box fit what it holds.
*/
.bf-tools-field .tc-add-tag-name input {
	width: 10em;
}
