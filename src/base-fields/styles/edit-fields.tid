title: $:/plugins/nikorion/base-fields/styles/edit-fields
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

/*
	Each pair of controls occupies a row of its own, added to the edit template as a
	section like any other — the core rows are left exactly as they are.

	A row packs its blocks to the left at their natural width rather than spreading
	them across the tiddler, so that a block's own parts stay together: the delete
	button sits right next to the control it clears, not at the far end of a stretched
	column. Rows wrap when the tiddler is too narrow.
*/

.bf-extra-row {
	display: flex;
	flex-wrap: wrap;
	align-items: baseline;
	gap: 4px 16px;
}

.bf-extra-row > * {
	flex: 0 0 auto;
}

.bf-edit-field {
	display: flex;
	align-items: center;
}

.bf-edit-field > em,
.bf-tools-field > em {
	flex: 0 0 auto;
	margin-inline-end: 8px;
}

.bf-edit-select {
	width: auto;
	max-width: 18em;
}

/*
	While the blank first option is the selected one, the select reads as a
	placeholder rather than as a value. `:has()` is a progressive nicety: without
	it the hint simply shows in the normal text colour.
*/
.bf-edit-select:has(option[value=""]:checked) {
	color: <<colour muted-foreground>>;
}

.bf-edit-select option {
	color: <<colour foreground>>;
}

.bf-delete-field {
	flex: 0 0 auto;
	padding: 0 2px;
}

/* Project: a single value, typed or picked, so the input is sized for a name. */

.bf-project-control {
	display: flex;
	align-items: center;
	position: relative;
}

.bf-project-control .bf-edit-input {
	width: 14em;
}

/* Drop the suggestions right under the input rather than after the flex row. */
.bf-project-control .tc-block-dropdown-wrapper {
	position: absolute;
	top: 100%;
	left: 0;
	right: 0;
	z-index: 1000;
}

.bf-dropdown-item {
	display: block;
	width: 100%;
	text-align: left;
	padding: 3px 14px;
	color: <<colour foreground>>;
}

.bf-dropdown-item:hover {
	background-color: <<colour dropdown-background>>;
	color: <<colour foreground>>;
	text-decoration: none;
}

/*
	`baseline` lines the tools label up with the first line of text inside the box,
	whatever that line happens to be — an existing tool pill, or the input when the
	field is still empty. A fixed padding would only ever suit one of the two.
*/
.bf-tools-field {
	display: flex;
	align-items: baseline;
}

.bf-tools-field .bf-tools-box {
	min-width: 20em;
}
