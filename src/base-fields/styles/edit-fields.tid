title: $:/plugins/nikorion/base-fields/styles/edit-fields
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

/*
	Each pair of controls joins a core row — Nature and Status beside Type, Tools and
	Project beside Tags — without any core tiddler being overridden.

	The edit template renders its sections as siblings of one container, so that
	container becomes a two-column grid: every section spans both columns, except the
	four that pair up, which take one each. The core sections keep column 1, sized to
	their content; the pairs take column 2. Should the edit form's internal nesting
	(`.tc-keyboard > .tc-keyboard`) ever change, the sections simply stack again —
	visible at a glance rather than silently wrong.
*/

.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard {
	display: grid;
	grid-template-columns: auto minmax(0, 1fr);
	align-items: start;
	column-gap: 16px;
}

.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > * {
	grid-column: 1 / -1;
	min-width: 0;
}

.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > .tc-edit-tags,
.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > .tc-edit-type-selector-wrapper {
	grid-column: 1;
}

.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > .bf-extra-row {
	grid-column: 2;
}

/*
	The core sizes the type control from the longest type name
	(`set-type-selector-min-width`), which would set the width of column 1 for the
	whole form. Let it shrink to what it actually needs.
*/
.tc-edit-type-selector-wrapper .tc-type-selector-dropdown-wrapper,
.tc-edit-type-selector-wrapper .tc-type-selector-dropdown-wrapper input.tc-edit-typeeditor {
	min-width: 0;
}

/* Too narrow for two columns: every section takes the full width again. */
@media (max-width: 1000px) {
	.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > .tc-edit-tags,
	.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > .tc-edit-type-selector-wrapper,
	.tc-tiddler-edit-frame > .tc-keyboard > .tc-keyboard > .bf-extra-row {
		grid-column: 1 / -1;
	}
}

/*
	Within a pair, blocks are packed to the left at their natural width rather than
	spread across the column, so a block's own parts stay together: the delete button
	sits next to the control it clears, not at the far end of a stretched column.
*/

/*
	`nowrap` on purpose: with wrapping, a block one pixel too wide drops onto its own
	line instead of giving way, and the pair no longer reads as one row. Below the
	breakpoint above, the whole section takes the full width anyway.
*/
.bf-extra-row {
	display: flex;
	flex-wrap: nowrap;
	align-items: baseline;
	gap: 4px 16px;
}

.bf-extra-row > * {
	flex: 0 1 auto;
	min-width: 0;
}

/* The tools box is the one that gives: its pills wrap inside it. */
.bf-tags-extras > .bf-tools-field {
	flex: 1 1 12em;
}

.bf-tags-extras > .bf-edit-field-project {
	flex: 0 0 auto;
}

.bf-edit-field {
	display: flex;
	align-items: center;
}

.bf-edit-field > em,
.bf-tools-field > em {
	flex: 0 0 auto;
	margin-inline-end: 8px;
}

.bf-edit-select {
	width: auto;
	max-width: 18em;
}

/*
	While the blank first option is the selected one, the select reads as a
	placeholder rather than as a value. `:has()` is a progressive nicety: without
	it the hint simply shows in the normal text colour.
*/
.bf-edit-select:has(option[value=""]:checked) {
	color: <<colour muted-foreground>>;
}

.bf-edit-select option {
	color: <<colour foreground>>;
}

.bf-delete-field {
	flex: 0 0 auto;
	padding: 0 2px;
}

/* Project: a single value, typed or picked, so the input is sized for a name. */

.bf-project-control {
	display: flex;
	align-items: center;
	position: relative;
}

.bf-project-control .bf-edit-input {
	width: 12em;
	min-width: 0;
}

/* Drop the suggestions right under the input rather than after the flex row. */
.bf-project-control .tc-block-dropdown-wrapper {
	position: absolute;
	top: 100%;
	left: 0;
	right: 0;
	z-index: 1000;
}

.bf-dropdown-item {
	display: block;
	width: 100%;
	text-align: left;
	padding: 3px 14px;
	color: <<colour foreground>>;
}

.bf-dropdown-item:hover {
	background-color: <<colour dropdown-background>>;
	color: <<colour foreground>>;
	text-decoration: none;
}

/*
	`baseline` lines the tools label up with the first line of text inside the box,
	whatever that line happens to be — an existing tool pill, or the input when the
	field is still empty. A fixed padding would only ever suit one of the two.
*/
.bf-tools-field {
	display: flex;
	align-items: baseline;
}

.bf-tools-field .bf-tools-box {
	min-width: 12em;
}
