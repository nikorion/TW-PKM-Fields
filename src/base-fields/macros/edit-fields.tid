title: $:/plugins/nikorion/base-fields/macros/edit-fields
tags: $:/tags/Global

<!--
	The editor controls for the fields of the kms ontology (KMS Ontology plugin).
	Nothing here knows a field by name: `bf-field` reads the field's `kind` from the
	ontology and draws the matching control —

	  kind         control
	  vocab        a dropdown, or radio buttons (`$:/config/nikorion/base-fields/control/<field>: radio`)
	  vocab-list   one checkbox per value
	  value        an input completing on the values already used, with a dropdown of them
	  list         pills plus an input, edited like the tags

	Labels, descriptions, vocabularies and icons all come from the ontology API
	(`kms-*` functions); only the editor's own strings (placeholders, button tooltips…)
	live in this plugin's language files, per field when the wording needs it, else
	generic (`bf-field-text`).
-->

<!-- Row layout: which fields a row shows, in order (`$:/config/nikorion/base-fields/row/<row>`). -->
\function bf-row-fields(row)
[[$:/config/nikorion/base-fields/row/]addsuffix<row>get[text]enlist-input[]] :intersection[function[kms-fields]]
\end

\function bf-placed-fields()
[[$:/config/nikorion/base-fields/row/pre-tags]get[text]enlist-input[]] [[$:/config/nikorion/base-fields/row/post-tags]get[text]enlist-input[]] [[$:/config/nikorion/base-fields/row/type]get[text]enlist-input[]]
\end

<!--
	A field of the ontology that no row names still gets a control: a vocabulary field
	at the end of the type row, a free one at the end of the row under the tags.
-->
\function bf-unplaced-vocab-fields()
[function[kms-fields]] -[function[bf-placed-fields]] :filter[function[kms-field-kind],<currentTiddler>prefix[vocab]]
\end

\function bf-unplaced-free-fields()
[function[kms-fields]] -[function[bf-placed-fields]] :filter[function[kms-field-kind],<currentTiddler>!prefix[vocab]]
\end

<!--
	An editor string for one field: `Fields/<field>/<key>` when the field has its own
	wording, else the generic `Fields/<key>`. Both cascade lang → en-GB. The cascades are
	two functions of their own because a filter run cannot be grouped: an `:else` run
	followed by `+[…]` runs would apply those to the first cascade's result too.
-->
\function bf-field-text-own(field,key)
[[$:/language]get[text]get[name]else[en-GB]] [[en-GB]]
+[addprefix[$:/plugins/nikorion/base-fields/language/]] +[addsuffix[/Fields/]]
+[addsuffix<field>] +[addsuffix[/]] +[addsuffix<key>]
+[get[text]] +[limit[1]]
\end

\function bf-field-text-generic(key)
[[$:/language]get[text]get[name]else[en-GB]] [[en-GB]]
+[addprefix[$:/plugins/nikorion/base-fields/language/]] +[addsuffix[/Fields/]]
+[addsuffix<key>]
+[get[text]] +[limit[1]]
\end

\function bf-field-text(field,key)
[function[bf-field-text-own],<field>,<key>] :else[function[bf-field-text-generic],<key>]
\end

<!-- The placeholder of an input: the field's own, else its label in lower case. -->
\function bf-placeholder(field)
[function[bf-field-text-own],<field>,[Placeholder]] :else[function[kms-field-label],<field>lowercase[]]
\end

<!-- The label before a control, "Role:": the ontology's label (`label`, set by the caller) in the language's prompt format. -->
\function bf-prompt()
[function[bf-field-text-generic],[Prompt]search-replace[$label$],<label>]
\end

<!-- Choosing the empty option clears the field instead of storing an empty string. -->
\procedure bf-clear-empty-field()
<$list filter="[<currentTiddler>!has<field>]" variable="ignore">
<$action-deletefield $field=<<field>>/>
</$list>
\end

<!--
	The tiddler's `icon` follows its role: the icon tiddler of the role's value becomes
	the value of `icon`, and a role with no icon (or no role) removes it. An icon that
	is not one of ours was set by hand and is left alone. Icons set by Base Fields 0.3
	(`…/base-fields/vocab/icons/…`) count as ours, and are replaced by the ontology's.
-->
\procedure bf-sync-role-icon()
<%if [<field>match[role]] %>
<$let role={{{ [<currentTiddler>get[role]] }}} iconTiddler={{{ [function[kms-vocab-icon-tiddler],[role],<role>] }}}>
<%if [<currentTiddler>get[icon]!match[]!prefix[$:/plugins/nikorion/kms-ontology/icons/]!prefix[$:/plugins/nikorion/base-fields/vocab/icons/]] %>
<%elseif [<iconTiddler>!match[]] %>
<$action-setfield $field="icon" $value=<<iconTiddler>>/>
<%else%>
<$action-deletefield $field="icon"/>
<%endif%>
</$let>
<%endif%>
\end

\procedure bf-field-changed()
<<bf-clear-empty-field>>
<<bf-sync-role-icon>>
\end

<!--
	The same clear button the core offers on Type — always shown, like the core one,
	so the row keeps a stable shape whether or not the field holds a value.
-->
\procedure bf-delete-field-button(field)
\whitespace trim
<$let label={{{ [function[kms-field-label],<field>lowercase[]] }}}
	hint={{{ [function[bf-field-text-generic],[Delete/Hint]search-replace[$label$],<label>] }}}
>
<$button class="tc-btn-invisible tc-btn-icon bf-delete-field" tooltip=<<hint>> aria-label=<<hint>>>
{{$:/core/images/delete-button}}
<$action-deletefield $field=<<field>>/>
<<bf-sync-role-icon>>
</$button>
</$let>
\end

<!--
	Why a control is flagged: the field does not apply to the tiddler (its role changed
	since), yet still holds a value. The tooltip names the role — "The tasks do not use
	this field — clear it" — from the role's plural in the ontology; a field may carry
	its own sentence instead (`Fields/<field>/Stale/Hint`, which `status` does, and
	`…/Stale/NoRole/Hint` for a tiddler with no role at all).
-->
\function bf-stale-with-role(plural)
[function[bf-field-text-generic],[Stale/Prefix]] [<plural>] [function[bf-field-text-generic],[Stale/Suffix]] +[join[ ]]
\end

<!--
	One field of the ontology, drawn according to its kind. A field that does not apply
	to the tiddler (`applies-filter` of its definition) is left out — unless it holds a
	value: it is then shown `stale`, framed in red, so the value can be seen and cleared
	rather than lurk unseen yet still matched by filters.
-->
\procedure bf-field(field)
\whitespace trim
<$let kind={{{ [function[kms-field-kind],<field>] }}}
	appliesFilter={{{ [function[kms-field-applies-filter],<field>] }}}
	applies={{{ [<appliesFilter>is[blank]then[yes]] :else[subfilter<appliesFilter>then[yes]] }}}
>
<%if [<applies>match[yes]] %>
<<bf-field-control field=<<field>> kind=<<kind>> >>
<%elseif [<currentTiddler>has<field>] %>
<$let plural={{{ [<currentTiddler>get[role]!match[]] :map[function[kms-vocab-plural],[role],<currentTiddler>] }}}
	own={{{ [function[bf-field-text-own],<field>,[Stale/Hint]] }}}
	noRole={{{ [function[bf-field-text-own],<field>,[Stale/NoRole/Hint]] }}}
	staleHint={{{ [<plural>match[]then<noRole>!match[]] :else[<own>!match[]] :else[function[bf-stale-with-role],<plural>] }}}
>
<<bf-field-control field=<<field>> kind=<<kind>> stale="yes" staleHint=<<staleHint>> >>
</$let>
<%endif%>
</$let>
\end

\procedure bf-field-control(field,kind,stale,staleHint)
\whitespace trim
<%if [<kind>match[vocab]] %>
<<bf-select-field field=<<field>> stale=<<stale>> staleHint=<<staleHint>> >>
<%elseif [<kind>match[vocab-list]] %>
<<bf-checkbox-field field=<<field>> stale=<<stale>> staleHint=<<staleHint>> >>
<%elseif [<kind>match[value]] %>
<<bf-single-value-field field=<<field>> stale=<<stale>> staleHint=<<staleHint>> >>
<%elseif [<kind>match[list]] %>
<<bf-list-value-field field=<<field>> stale=<<stale>> staleHint=<<staleHint>> >>
<%endif%>
\end

<!--
	The label of a labelled control, with the field's description (from the ontology)
	as its tooltip. Not in a red frame: the frame's own tooltip must show there, and an
	inner `title`, even an empty one, would hide it.
-->
\procedure bf-field-label(field,stale)
\whitespace trim
<$let label={{{ [function[kms-field-label],<field>] }}} description={{{ [function[kms-field-description],<field>] }}}>
<%if [<stale>match[yes]] :else[<description>is[blank]then[yes]] %>
<em class="tc-edit tc-small-gap-right"><$text text={{{ [function[bf-prompt]] }}}/></em>
<%else%>
<em class="tc-edit tc-small-gap-right" title=<<description>>><$text text={{{ [function[bf-prompt]] }}}/></em>
<%endif%>
</$let>
\end

<!--
	One entry of a vocabulary dropdown: what the value looks like, and what it means
	as the tooltip. A value shipped without a description simply gets no tooltip.
-->
\procedure bf-vocab-option(field,slug)
\whitespace trim
<option value=<<slug>> title={{{ [function[kms-vocab-hint],<field>,<slug>] }}}><$transclude $variable="kms-vocab-item" field=<<field>> value=<<slug>>/></option>
\end

<!-- `vocab` kind: one value from the vocabulary, as a dropdown or as radio buttons. -->
\procedure bf-select-field(field,stale,staleHint)
\whitespace trim
<span class={{{ [[bf-edit-field]] [<stale>match[yes]then[bf-stale]] +[join[ ]] }}} title=<<staleHint>>>
<<bf-field-label field=<<field>> stale=<<stale>> >>
<%if [[$:/config/nikorion/base-fields/control/]addsuffix<field>get[text]match[radio]] %>
<!--
	Radio buttons. The vocabulary's blank value, if any, stands for the empty field: its
	button carries the value "" — checked while the field is empty, and choosing it
	clears the field. A blank value without an icon reads as an absence (italics).
-->
<$let blank={{{ [function[kms-vocab-blank],<field>] }}}>
<span class="bf-radio-group" role="radiogroup">
<$list filter="[function[kms-vocab-values],<field>]" variable="slug">
<$let icon={{{ [function[kms-vocab-icon],<field>,<slug>] }}}
	itemClass={{{ [<icon>is[blank]then<slug>match<blank>then[bf-vocab-none]] }}}
>
<$radio tiddler=<<currentTiddler>> field=<<field>> value={{{ [<slug>!match<blank>] }}} default=""
	class="bf-radio" tabindex={{$:/config/EditTabIndex}} actions=<<bf-field-changed>>
>
<%if [<stale>match[yes]] %>
<span class=<<itemClass>>><$transclude $variable="kms-vocab-item" field=<<field>> value=<<slug>>/></span>
<%else%>
<span class=<<itemClass>> title={{{ [function[kms-vocab-hint],<field>,<slug>] }}}><$transclude $variable="kms-vocab-item" field=<<field>> value=<<slug>>/></span>
<%endif%>
</$radio>
</$let>
</$list>
</span>
</$let>
<%else%>
<!--
	`default` is not optional: with no value the select widget assigns `undefined` to the
	DOM node, which matches no option at all — the control would go blank instead of
	falling back to the placeholder option below.

	A `<select>` has no placeholder attribute, so an option plays that part: it is what
	an empty field shows, instead of the first vocabulary value. `hidden` keeps it out of
	the open list — it stands for nothing to choose — while the browser goes on showing
	it in the closed control; `disabled` stops the keyboard landing on it. Clearing is
	the button next to the control. The stylesheet greys the control while this option
	is the selected one.
-->
<$select tiddler=<<currentTiddler>> field=<<field>> class="tc-edit-texteditor bf-edit-select"
	default="" tabindex={{$:/config/EditTabIndex}} actions=<<bf-field-changed>>
>
<option value="" disabled="disabled" hidden="hidden"><$text text={{{ [function[bf-placeholder],<field>] }}}/></option>
<!-- Whatever no group claims comes first, then one heading per group. -->
<$list filter="[function[kms-vocab-ungrouped-values],<field>]" variable="slug">
<<bf-vocab-option field=<<field>> slug=<<slug>> >>
</$list>
<$list filter="[function[kms-vocab-groups],<field>]" variable="group">
<optgroup label={{{ [function[kms-vocab-group-label],<field>,<group>] }}} title={{{ [function[kms-vocab-group-hint],<field>,<group>] }}}>
<$list filter="[function[kms-vocab-group-values],<field>,<group>]" variable="slug">
<<bf-vocab-option field=<<field>> slug=<<slug>> >>
</$list>
</optgroup>
</$list>
</$select>
<%endif%>
<<bf-delete-field-button field=<<field>> >>
</span>
\end

<!--
	`vocab-list` kind: several values from the vocabulary, one checkbox each, ticked
	when the value is in the list. Ticking adds the slug to the list and unticking
	removes it, leaving the others alone (`listField` mode of the core checkbox).
	No `tooltip` on the checkbox widget: the value's hint is a `title` on a wrapper.
-->
\procedure bf-checkbox-field(field,stale,staleHint)
\whitespace trim
<span class={{{ [[bf-edit-field bf-checkbox-field]] [<stale>match[yes]then[bf-stale]] +[join[ ]] }}} title=<<staleHint>>>
<<bf-field-label field=<<field>> stale=<<stale>> >>
<$list filter="[function[kms-vocab-values],<field>]" variable="slug">
<%if [<stale>match[yes]] %>
<span class="bf-check">
<$checkbox tiddler=<<currentTiddler>> listField=<<field>> checked=<<slug>>>
<$transclude $variable="kms-vocab-item" field=<<field>> value=<<slug>>/>
</$checkbox>
</span>
<%else%>
<span class="bf-check" title={{{ [function[kms-vocab-hint],<field>,<slug>] }}}>
<$checkbox tiddler=<<currentTiddler>> listField=<<field>> checked=<<slug>>>
<$transclude $variable="kms-vocab-item" field=<<field>> value=<<slug>>/>
</$checkbox>
</span>
<%endif%>
</$list>
<<bf-delete-field-button field=<<field>> >>
</span>
\end

<!--
	`value` kind: a single free value, typed or picked from the values already used in
	the wiki — the same machinery as a list field's input and as the core Type control,
	except that the input writes straight into the field instead of feeding a list.
-->

\procedure bf-clear-single-state()
<$action-deletetiddler $filter="[<fieldInput>] [<fieldSelection>] [<fieldRefresh>] [<fieldPopup>]"/>
\end

\procedure bf-cancel-single-actions()
<%if [<fieldInput>has[text]] %>
<<bf-clear-single-state>>
<%else%>
<<cancel-delete-tiddler-actions "cancel">>
<%endif%>
\end

<!--
	The completion filters of `search-filters` name the field through `bfField`, not
	`field`: `keyboard-driven-input` has a `field` parameter of its own (the field of the
	input tiddler), which shadows ours where the filters are evaluated.
-->
\procedure bf-single-value-field(field,stale,staleHint)
\whitespace trim
<$let saveTiddler=<<currentTiddler>>
	bfField=<<field>>
	statePrefix={{{ [[$:/temp/]addsuffix<field>] }}}
	inputPath={{{ [<statePrefix>addsuffix[/input]] }}}
	selectionPath={{{ [<statePrefix>addsuffix[/selected-item]] }}}
	refreshPath={{{ [<statePrefix>addsuffix[/refresh]] }}}
	popupPath={{{ [[$:/state/popup/bf-]addsuffix<field>addsuffix[-dropdown]] }}}
	ariaLabel={{{ [function[kms-field-label],<field>] }}}
	placeholderText={{{ [function[bf-placeholder],<field>] }}}
	dropdownHint={{{ [function[bf-field-text],<field>,[Dropdown/Hint]] }}}
	dropdownEmpty={{{ [function[bf-field-text],<field>,[Dropdown/Empty]] }}}
	inputWidth={{{ [<placeholderText>length[]] [[12]] +[maxall[]addprefix[--bf-input-chars: ]] }}}
>
<$qualify name="fieldInput" title=<<inputPath>>>
<$qualify name="fieldSelection" title=<<selectionPath>>>
<$qualify name="fieldRefresh" title=<<refreshPath>>>
<$qualify name="fieldPopup" title=<<popupPath>>>
<span class={{{ [[bf-edit-field bf-edit-field-single]] [<stale>match[yes]then[bf-stale]] +[join[ ]] }}} title=<<staleHint>> role="group" aria-label=<<ariaLabel>>>
<<bf-field-label field=<<field>> stale=<<stale>> >>
<span class="bf-single-control" style=<<inputWidth>>>
<$transclude $variable="keyboard-driven-input"
	tiddler=<<currentTiddler>> field=<<field>> storeTitle=<<fieldInput>>
	refreshTitle=<<fieldRefresh>> selectionStateTitle=<<fieldSelection>>
	tag="input" default="" class="tc-edit-texteditor tc-popup-handle bf-edit-input"
	placeholder=<<placeholderText>>
	focusPopup=<<fieldPopup>> tabindex={{$:/config/EditTabIndex}} cancelPopups="yes"
	configTiddlerFilter="[[$:/plugins/nikorion/base-fields/search-filters]]"
	firstSearchFilterField="value-search-filter"
	inputCancelActions=<<bf-cancel-single-actions>>
/>
<$button popup=<<fieldPopup>> class="tc-btn-invisible tc-btn-dropdown" tooltip=<<dropdownHint>> aria-label=<<dropdownHint>>>
{{$:/core/images/down-arrow}}
</$button>
<div class="tc-block-dropdown-wrapper">
<$reveal state=<<fieldPopup>> type="nomatch" text="" default="">
<$let userInput={{{ [<fieldInput>get[text]] }}}>
<div class="tc-block-dropdown bf-single-dropdown">
<$list filter="[all[tiddlers]!has[draft.of]has<field>get<field>each:value[]sort[]search:title<userInput>]" variable="val"
	emptyMessage="""<div class="tc-dropdown-item"><$text text=<<dropdownEmpty>>/></div>"""
>
<$button tag="a" class={{{ [<val>addsuffix[-primaryList]] :except[<fieldSelection>get[text]] :and[then[tc-btn-invisible bf-dropdown-item]else[tc-btn-invisible bf-dropdown-item tc-tag-button-selected]] }}}>
<$action-setfield $tiddler=<<saveTiddler>> $field=<<field>> $value=<<val>>/>
<$action-deletetiddler $filter="[<fieldInput>] [<fieldSelection>] [<fieldPopup>]"/>
<!-- The input keeps showing what was typed unless it is told to re-read the field:
	an edit-text widget leaves a focused element alone so as not to clobber typing. -->
<$action-setfield $tiddler=<<fieldRefresh>> text="yes"/>
<$text text=<<val>>/>
</$button>
</$list>
</div>
</$let>
</$reveal>
</div>
</span>
<<bf-delete-field-button field=<<field>> >>
</span>
</$qualify>
</$qualify>
</$qualify>
</$qualify>
</$let>
\end

<!--
	`list` kind: a list of free values, edited like tags — pills plus an input completing
	on the values already used in that field elsewhere in the wiki.

	It deliberately does //not// call the core `tag-picker` macro. That macro hardcodes
	the tags placeholder (`$:/language/EditTemplate/Tags/Add/Placeholder`) and reuses the
	tag input state the edit template defines once for the whole form, so the pickers
	would fight over a single input — and a half-typed value would be added as a //tag//
	by the save-tiddler shortcut. Driving `keyboard-driven-input` directly — the very
	macro `tag-picker` and the core Type control are built on — keeps the same keyboard
	behaviour (Enter to add, up/down through the suggestions, Escape to clear) while
	owning the placeholder and the state tiddlers.
-->

<!--
	Width of a list field's input, in characters: the longest placeholder among the list
	fields, so their inputs line up and none cuts its placeholder short.
-->
\function bf-list-placeholder-chars()
[function[kms-fields]] :filter[function[kms-field-kind],<currentTiddler>match[list]] :map[function[bf-placeholder],<currentTiddler>length[]] +[maxall[]]
\end

\procedure bf-clear-list-state()
<$action-deletetiddler $filter="[<newValueTiddler>] [<newValueInput>] [<newValueSelection>] [<newValueRefresh>] [<newValuePopup>]"/>
\end

<!-- `variable` is mandatory on the guard list: without it the list rebinds
	currentTiddler to the new value, and listops would target that tiddler
	instead of the one being edited. -->
\procedure bf-add-list-actions()
<$let value={{{ [<newValueTiddler>get[text]trim[]] }}}>
<$list filter="[<value>!match[]]" variable="ignore">
<$action-listops $tiddler=<<saveTiddler>> $field=<<field>> $subfilter="[<value>]"/>
</$list>
<<bf-clear-list-state>>
</$let>
\end

\procedure bf-cancel-list-actions()
<%if [<newValueTiddler>has[text]] :else[<newValueInput>has[text]] %>
<<bf-clear-list-state>>
<%else%>
<<cancel-delete-tiddler-actions "cancel">>
<%endif%>
\end

\procedure bf-list-value-field(field,stale,staleHint)
\whitespace trim
<$let saveTiddler=<<currentTiddler>>
	bfField=<<field>>
	statePrefix={{{ [[$:/temp/New]addsuffix<field>addsuffix[Value]] }}}
	inputPath={{{ [<statePrefix>addsuffix[/input]] }}}
	selectionPath={{{ [<statePrefix>addsuffix[/selected-item]] }}}
	refreshPath={{{ [<statePrefix>addsuffix[/refresh]] }}}
	popupPath={{{ [[$:/state/popup/bf-]addsuffix<field>addsuffix[-dropdown]] }}}
	ariaLabel={{{ [function[kms-field-label],<field>] }}}
	placeholderText={{{ [function[bf-placeholder],<field>] }}}
	dropdownHint={{{ [function[bf-field-text],<field>,[Dropdown/Hint]] }}}
	dropdownEmpty={{{ [function[bf-field-text],<field>,[Dropdown/Empty]] }}}
	removeHint={{{ [function[bf-field-text],<field>,[Remove/Hint]] }}}
>
<$qualify name="newValueTiddler" title=<<statePrefix>>>
<$qualify name="newValueInput" title=<<inputPath>>>
<$qualify name="newValueSelection" title=<<selectionPath>>>
<$qualify name="newValueRefresh" title=<<refreshPath>>>
<$qualify name="newValuePopup" title=<<popupPath>>>
<!--
	No visible label: the placeholder says what the control is for, and the row has
	only so much width to give. `role`/`aria-label` keep the control named for a
	screen reader.
-->
<span class={{{ [[bf-list-field]] [<stale>match[yes]then[bf-stale]] +[join[ ]] }}} title=<<staleHint>> role="group" aria-label=<<ariaLabel>>>
<div class="tc-edit-tags bf-list-box">
<$list filter="[<currentTiddler>get<field>enlist-input[]sort[]]" variable="value" storyview="pop">
<$transclude $variable="kms-pill" field=<<field>> value=<<value>>>
<$fill $name="kms-pill-after">
<$button class="tc-btn-invisible tc-remove-tag-button" style.fill=<<foregroundColor>> tooltip=<<removeHint>> aria-label=<<removeHint>>>
<$action-listops $tiddler=<<saveTiddler>> $field=<<field>> $subfilter="-[<value>]"/>
{{$:/core/images/close-button}}
</$button>
</$fill>
</$transclude>
</$list>
<div class="tc-edit-add-tag">
<div class="tc-edit-add-tag-ui">
<span class="tc-add-tag-name tc-small-gap-right" style={{{ [function[bf-list-placeholder-chars]addprefix[--bf-input-chars: ]] }}}>
<$transclude $variable="keyboard-driven-input"
	tiddler=<<newValueTiddler>> field="text" storeTitle=<<newValueInput>>
	refreshTitle=<<newValueRefresh>> selectionStateTitle=<<newValueSelection>>
	tag="input" default="" class="tc-edit-texteditor tc-popup-handle"
	placeholder=<<placeholderText>>
	focusPopup=<<newValuePopup>> tabindex={{$:/config/EditTabIndex}} cancelPopups="yes"
	configTiddlerFilter="[[$:/plugins/nikorion/base-fields/search-filters]]"
	firstSearchFilterField="list-search-filter"
	inputAcceptActions=<<bf-add-list-actions>>
	inputCancelActions=<<bf-cancel-list-actions>>
/>
</span>
<$button popup=<<newValuePopup>> class="tc-btn-invisible tc-btn-dropdown" tooltip=<<dropdownHint>> aria-label=<<dropdownHint>>>
{{$:/core/images/down-arrow}}
</$button>
<span class="tc-add-tag-button tc-small-gap-left">
<$button actions=<<bf-add-list-actions>>>
{{$:/language/EditTemplate/Tags/Add/Button}}
</$button>
</span>
</div>
<div class="tc-block-dropdown-wrapper">
<$reveal state=<<newValuePopup>> type="nomatch" text="" default="">
<$let userInput={{{ [<newValueInput>get[text]] }}}>
<div class="tc-block-dropdown bf-list-dropdown">
<$list filter="[all[tiddlers]!has[draft.of]has<field>each:list-item<field>sort[]search:title<userInput>]" variable="value"
	emptyMessage="""<div class="tc-dropdown-item"><$text text=<<dropdownEmpty>>/></div>"""
>
