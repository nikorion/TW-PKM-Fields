title: $:/plugins/nikorion/base-fields/macros/edit-fields
tags: $:/tags/Global

<!-- Controls rendered on the Type row of the edit template. -->

<!-- Choosing the empty option clears the field instead of storing an empty string. -->
\procedure bf-clear-empty-field()
<$list filter="[<currentTiddler>!has<field>]">
<$action-deletefield $field=<<field>>/>
</$list>
\end

<!--
	The tiddler's `icon` follows its role: the vocabulary icon (already a tiddler, whose
	text is the emoji) becomes the value of `icon`, and clearing the role removes it.
	An icon that is not one of ours was set by hand and is left alone.
-->
\procedure bf-sync-role-icon()
<%if [<field>match[role]] %>
<%if [<currentTiddler>get[icon]!match[]!prefix[$:/plugins/nikorion/base-fields/vocab/icons/]] %>
<%elseif [<currentTiddler>get[role]addprefix[$:/plugins/nikorion/base-fields/vocab/icons/role/]get[text]!match[]] %>
<$action-setfield $field="icon" $value={{{ [<currentTiddler>get[role]addprefix[$:/plugins/nikorion/base-fields/vocab/icons/role/]] }}}/>
<%else%>
<$action-deletefield $field="icon"/>
<%endif%>
<%endif%>
\end

\procedure bf-field-changed()
<<bf-clear-empty-field>>
<<bf-sync-role-icon>>
\end

<!--
	The same clear button the core offers on Type, for the fields added here —
	always shown, like the core one, so the row keeps a stable shape whether or not
	the field holds a value.
-->
\procedure bf-delete-field-button(field)
\whitespace trim
<$let hintKey={{{ [[Fields/]addsuffix<field>addsuffix[/Delete/Hint]] }}}>
<$button class="tc-btn-invisible tc-btn-icon bf-delete-field"
	tooltip={{{ [function[base-fields-lingo-text],<hintKey>] }}}
	aria-label={{{ [function[base-fields-lingo-text],<hintKey>] }}}
>
{{$:/core/images/delete-button}}
<$action-deletefield $field=<<field>>/>
<<bf-sync-role-icon>>
</$button>
</$let>
\end

<!--
	One entry of a vocabulary dropdown: what the value looks like, and what it means
	as the tooltip. A value shipped without a description simply gets no tooltip.
-->
\procedure bf-vocab-option(field,slug)
\whitespace trim
<option value=<<slug>> title={{{ [function[bf-vocab-hint],<field>,<slug>] }}}><<bf-vocab-item field=<<field>> value=<<slug>> >></option>
\end

<!--
	Why a control is flagged: the role the tiddler now has does not use this field, and
	the tooltip says so by name (a field may carry its own sentence, `Fields/<field>/Stale/Hint`,
	when a list of roles reads better than the current one — `status` does — and
	`Fields/<field>/Stale/NoRole/Hint` for a tiddler that has no role at all) — "Tasks do not use this field — clear it". The role's
	plural comes from the vocabulary strings. A control is only ever flagged on a tiddler
	that has a role, so there is always one to name.
-->
\function bf-stale-with-role(plural)
[function[base-fields-lingo-text],[Fields/Stale/Prefix]] [<plural>] [function[base-fields-lingo-text],[Fields/Stale/Suffix]] +[join[ ]]
\end

<!--
	Single value picked from a controlled vocabulary (role, maturity, status, lifecycle).
	`stale="yes"` marks a control shown only because its field still holds a value the
	tiddler's role no longer accounts for: it gets a red frame and an explanatory tooltip.
-->
\procedure bf-select-field(field,stale)
\whitespace trim
<$let promptKey={{{ [[Fields/]addsuffix<field>addsuffix[/Prompt]] }}}
	placeholderKey={{{ [[Fields/]addsuffix<field>addsuffix[/Placeholder]] }}}
	plural={{{ [<currentTiddler>get[role]!match[]] :map[function[bf-vocab-plural],<currentTiddler>] }}}
	specificKey={{{ [[Fields/]addsuffix<field>addsuffix[/Stale/Hint]] }}}
	specific={{{ [function[base-fields-lingo-text],<specificKey>] }}}
	noRoleKey={{{ [[Fields/]addsuffix<field>addsuffix[/Stale/NoRole/Hint]] }}}
	noRole={{{ [function[base-fields-lingo-text],<noRoleKey>] }}}
	hint={{{ [<plural>match[]then<noRole>!match<noRoleKey>] :else[<specific>!match<specificKey>] :else[function[bf-stale-with-role],<plural>] }}}
	staleHint={{{ [<stale>match[yes]] :map[<hint>] }}}
>
<span class={{{ [[bf-edit-field]] [<stale>match[yes]then[bf-stale]] +[join[ ]] }}} title=<<staleHint>>>
<em class="tc-edit tc-small-gap-right"><<base-fields-lingo title=<<promptKey>> >></em>
<!--
	`default` is not optional: with no value the select widget assigns `undefined`
	to the DOM node, which matches no option at all — the control would go blank
	instead of falling back to the placeholder option below.
-->
<%if [[$:/plugins/nikorion/base-fields/vocab/]addsuffix<field>get[radio]match[yes]] %>
<!--
	A vocabulary flagged `radio: yes` is edited with radio buttons instead of a dropdown.
	`default` is the value shown checked while the field is empty; `blank-value` is the one
	that stands for an empty field itself (choosing it clears the field).
-->
<$let vocab={{{ [[$:/plugins/nikorion/base-fields/vocab/]addsuffix<field>] }}}
	blank={{{ [<vocab>get[blank-value]] }}}
	radioDefault={{{ [<vocab>get[default]] }}}
>
<span class="bf-radio-group" role="radiogroup">
<$list filter="[function[bf-vocab-values],<field>]" variable="slug">
<$radio tiddler=<<currentTiddler>> field=<<field>> value={{{ [<slug>!match<blank>] }}} default=<<radioDefault>>
	class="bf-radio" tabindex={{$:/config/EditTabIndex}} actions=<<bf-field-changed>>
>
<!-- In a red frame the whole control shows the frame's own tooltip: an inner `title`, even an empty one, would hide it. -->
<%if [<stale>match[yes]] %>
<span class={{{ [<slug>match[none]then[bf-vocab-none]] }}}><<bf-vocab-item field=<<field>> value=<<slug>> >></span>
<%else%>
<span class={{{ [<slug>match[none]then[bf-vocab-none]] }}} title={{{ [function[bf-vocab-hint],<field>,<slug>] }}}><<bf-vocab-item field=<<field>> value=<<slug>> >></span>
<%endif%>
</$radio>
</$list>
</span>
</$let>
<%else%>
<$select tiddler=<<currentTiddler>> field=<<field>> class="tc-edit-texteditor bf-edit-select"
	default="" tabindex={{$:/config/EditTabIndex}} actions=<<bf-field-changed>>
>
<!--
	A `<select>` has no placeholder attribute, so an option plays that part: it is
	what an empty field shows, instead of the first vocabulary value on a tiddler
	that holds no value at all. `hidden` keeps it out of the list once the list is
	open — it stands for nothing to choose — while the browser goes on showing it in
	the closed control, which is all it is there for; `disabled` stops the keyboard
	landing on it. Clearing is the button next to the control. The stylesheet greys
	the control while this option is the one selected.
-->
<option value="" disabled="disabled" hidden="hidden"><<base-fields-lingo title=<<placeholderKey>> >></option>
<!--
	Whatever no group claims comes first, then one heading per group — a vocabulary
	that declares no group simply lists its values, as before.
-->
<$list filter="[function[bf-vocab-ungrouped-values],<field>]" variable="slug">
<<bf-vocab-option field=<<field>> slug=<<slug>> >>
</$list>
<$list filter="[function[bf-vocab-groups],<field>]" variable="group">
<optgroup label={{{ [function[bf-vocab-group-label],<field>,<group>] }}} title={{{ [function[bf-vocab-group-hint],<field>,<group>] }}}>
<$list filter="[function[bf-vocab-group-values],<field>,<group>]" variable="slug">
<<bf-vocab-option field=<<field>> slug=<<slug>> >>
</$list>
</optgroup>
</$list>
</$select>
<%endif%>
<<bf-delete-field-button field=<<field>> >>
</span>
</$let>
\end

<!--
	`needs` is a list field whose values come from a controlled vocabulary, several of
	which can hold at once: one checkbox per value, ticked when the value is in the
	list. Ticking adds the slug to the list and unticking removes it, leaving the
	others alone (`listField` mode of the core checkbox widget).
-->

\procedure bf-needs-field(stale)
\whitespace trim
<$let plural={{{ [<currentTiddler>get[role]!match[]] :map[function[bf-vocab-plural],<currentTiddler>] }}}
	hint={{{ [function[bf-stale-with-role],<plural>] }}}
	staleHint={{{ [<stale>match[yes]] :map[<hint>] }}}
>
<span class={{{ [[bf-edit-field bf-needs-field]] [<stale>match[yes]then[bf-stale]] +[join[ ]] }}} title=<<staleHint>>>
<em class="tc-edit tc-small-gap-right"><<base-fields-lingo title="Fields/needs/Prompt">></em>
<$list filter="[function[bf-vocab-values],[needs]]" variable="slug">
<%if [<stale>match[yes]] %>
<span class="bf-need">
<$checkbox tiddler=<<currentTiddler>> listField="needs" checked=<<slug>>>
<<bf-vocab-item field="needs" value=<<slug>> >>
</$checkbox>
</span>
<%else%>
<span class="bf-need" title={{{ [function[bf-vocab-hint],[needs],<slug>] }}}>
<$checkbox tiddler=<<currentTiddler>> listField="needs" checked=<<slug>>>
<<bf-vocab-item field="needs" value=<<slug>> >>
</$checkbox>
</span>
<%endif%>
</$list>
<<bf-delete-field-button field="needs">>
</span>
</$let>
\end

<!--
	A single free value, typed or picked from the values already used in the wiki —
	the same machinery as a list field's input and as the core Type control, except
	that the input writes straight into the field instead of feeding a list. Shared
	by every such field (`project`, `epistemology`): the field name is a parameter,
	so state tiddlers, prompt/placeholder/dropdown strings and the completion filter
	are all derived from it rather than duplicated per field.
-->

\procedure bf-clear-single-state()
<$action-deletetiddler $filter="[<fieldInput>] [<fieldSelection>] [<fieldRefresh>] [<fieldPopup>]"/>
\end

\procedure bf-cancel-single-actions()
<%if [<fieldInput>has[text]] %>
<<bf-clear-single-state>>
<%else%>
<<cancel-delete-tiddler-actions "cancel">>
<%endif%>
\end

\procedure bf-single-value-field(field)
\whitespace trim
<$let saveTiddler=<<currentTiddler>>
	statePrefix={{{ [[$:/temp/]addsuffix<field>] }}}
	inputPath={{{ [<statePrefix>addsuffix[/input]] }}}
	selectionPath={{{ [<statePrefix>addsuffix[/selected-item]] }}}
	refreshPath={{{ [<statePrefix>addsuffix[/refresh]] }}}
	popupPath={{{ [[$:/state/popup/bf-]addsuffix<field>addsuffix[-dropdown]] }}}
	promptKey={{{ [[Fields/]addsuffix<field>addsuffix[/Prompt]] }}}
	placeholderKey={{{ [[Fields/]addsuffix<field>addsuffix[/Placeholder]] }}}
	dropdownHintKey={{{ [[Fields/]addsuffix<field>addsuffix[/Dropdown/Hint]] }}}
	dropdownEmptyKey={{{ [[Fields/]addsuffix<field>addsuffix[/Dropdown/Empty]] }}}
	searchFilterField={{{ [<field>addsuffix[-search-filter]] }}}
	ariaLabel={{{ [function[base-fields-lingo-text],<promptKey>trim[:]trim[]] }}}
	placeholderText={{{ [function[base-fields-lingo-text],<placeholderKey>] }}}
	dropdownHint={{{ [function[base-fields-lingo-text],<dropdownHintKey>] }}}
	promptHintKey={{{ [<promptKey>addsuffix[/Hint]] }}}
	promptHint={{{ [function[base-fields-lingo-text],<promptHintKey>] -[<promptHintKey>] }}}
	inputWidth={{{ [<placeholderText>length[]] [[12]] +[maxall[]addprefix[--bf-input-chars: ]] }}}
>
<$qualify name="fieldInput" title=<<inputPath>>>
<$qualify name="fieldSelection" title=<<selectionPath>>>
<$qualify name="fieldRefresh" title=<<refreshPath>>>
<$qualify name="fieldPopup" title=<<popupPath>>>
<span class="bf-edit-field bf-edit-field-single" role="group"
	aria-label=<<ariaLabel>>
>
<!-- Labelled like Role, Maturity and Status: same markup — the placeholder inside
	the input says what to type. -->
<em class="tc-edit tc-small-gap-right" title=<<promptHint>>><<base-fields-lingo title=<<promptKey>> >></em>
<span class="bf-single-control" style=<<inputWidth>>>
<$transclude $variable="keyboard-driven-input"
	tiddler=<<currentTiddler>> field=<<field>> storeTitle=<<fieldInput>>
	refreshTitle=<<fieldRefresh>> selectionStateTitle=<<fieldSelection>>
	tag="input" default="" class="tc-edit-texteditor tc-popup-handle bf-edit-input"
	placeholder=<<placeholderText>>
	focusPopup=<<fieldPopup>> tabindex={{$:/config/EditTabIndex}} cancelPopups="yes"
	configTiddlerFilter="[[$:/plugins/nikorion/base-fields/search-filters]]"
	firstSearchFilterField=<<searchFilterField>>
	inputCancelActions=<<bf-cancel-single-actions>>
/>
<$button popup=<<fieldPopup>> class="tc-btn-invisible tc-btn-dropdown"
	tooltip=<<dropdownHint>>
	aria-label=<<dropdownHint>>
>
{{$:/core/images/down-arrow}}
</$button>
<div class="tc-block-dropdown-wrapper">
<$reveal state=<<fieldPopup>> type="nomatch" text="" default="">
<$let userInput={{{ [<fieldInput>get[text]] }}}>
<div class="tc-block-dropdown bf-single-dropdown">
<$list filter="[all[tiddlers]!has[draft.of]has<field>get<field>each:value[]sort[]search:title<userInput>]" variable="val"
	emptyMessage="""<div class="tc-dropdown-item"><<base-fields-lingo title=<<dropdownEmptyKey>>>></div>"""
>
<$button tag="a" class={{{ [<val>addsuffix[-primaryList]] :except[<fieldSelection>get[text]] :and[then[tc-btn-invisible bf-dropdown-item]else[tc-btn-invisible bf-dropdown-item tc-tag-button-selected]] }}}>
<$action-setfield $tiddler=<<saveTiddler>> $field=<<field>> $value=<<val>>/>
<$action-deletetiddler $filter="[<fieldInput>] [<fieldSelection>] [<fieldPopup>]"/>
<!-- The input keeps showing what was typed unless it is told to re-read the field:
	an edit-text widget leaves a focused element alone so as not to clobber typing. -->
<$action-setfield $tiddler=<<fieldRefresh>> text="yes"/>
<$text text=<<val>>/>
</$button>
</$list>
</div>
</$let>
</$reveal>
</div>
</span>
<<bf-delete-field-button field=<<field>> >>
</span>
</$qualify>
</$qualify>
</$qualify>
</$qualify>
</$let>
\end

<!--
	A list field, edited like tags: pills plus an input completing on the values
	already used in that field elsewhere in the wiki. Shared by every such field
	(`technology`, `equipment`, `disciplines`): the field name is a parameter, so
	state tiddlers, prompt/placeholder/dropdown strings and the completion filter
	are all derived from it rather than duplicated per field.

	It deliberately does //not// call the core `tag-picker` macro. That macro
	hardcodes the tags placeholder (`$:/language/EditTemplate/Tags/Add/Placeholder`)
	and reuses the tag input state the edit template defines once for the whole
	form, so the two pickers would fight over a single input — and a half-typed
	value would be added as a //tag// by the save-tiddler shortcut. Driving
	`keyboard-driven-input` directly — the very macro `tag-picker` and the core Type
	control are built on — keeps the same keyboard behaviour (Enter to add, up/down
	through the suggestions, Escape to clear) while owning the placeholder and the
	state tiddlers.
-->

<!--
	Width of a list field's input, in characters: the longest placeholder of the
	three, so the three inputs line up and none cuts its placeholder short.
-->
\function bf-list-placeholder-chars()
[enlist[disciplines technology equipment]addprefix[Fields/]addsuffix[/Placeholder]] :map[function[base-fields-lingo-text],<currentTiddler>length[]] +[maxall[]]
\end

<!--
	One pill, rendered exactly like a tag pill: same classes, same per-value
	colour cascade (`$:/tags/TiddlerColourFilter`), same contrast-computed
	foreground, same icon cascade. The core equivalent lives in
	`$:/core/ui/EditTemplate/tags` as the local procedures `tag-body`/`tag-body-inner`,
	which are not reachable from outside that tiddler — hence this copy rather than a
	call. Keep it in step with the core version when upgrading TiddlyWiki.
	`readonly="yes"` drops the remove button, for pills shown outside an editor
	(a TW-Dynamic-Table cell out of edit mode, a view template…).
-->

\procedure bf-list-pill(field,value,readonly)
\whitespace trim
<$let palette={{$:/palette}}
	removeHintKey={{{ [[Fields/]addsuffix<field>addsuffix[/Remove/Hint]] }}}
	removeHint={{{ [function[base-fields-lingo-text],<removeHintKey>] }}}
	fallbackTiddler={{{ [[$:/config/nikorion/base-fields/]addsuffix<field>addsuffix[/Colour]] }}}
	fallbackColour={{{ [{$:/palette}get[color-scheme]match[dark]then<fallbackTiddler>get[dark]] :else[<fallbackTiddler>get[text]] +[trim[]] }}}
>
<!--
	Same colour cascade as a tag pill, with one difference: where a tag falls back to
	the palette's `tag-background`, a value here falls back to a colour of its own, so
	the two kinds of pill stay told apart at a glance on a tiddler carrying both. The
	fallback is a per-field configuration tiddler, not a literal, so a wiki can pick
	another (`$:/config/nikorion/base-fields/<field>/Colour`; its optional `dark` field
	replaces the text when the active palette's `color-scheme` is `dark`).
-->
<$let colour={{{ [<value>] :cascade[all[shadows+tiddlers]tag[$:/tags/TiddlerColourFilter]!is[draft]get[text]] :and[!match[]] :else[<fallbackColour>] }}}
	icon={{{ [<value>] :cascade[all[shadows+tiddlers]tag[$:/tags/TiddlerIconFilter]!is[draft]get[text]] }}}
	colourA={{{ [<palette>getindex[foreground]] }}}
	colourB={{{ [<palette>getindex[background]] }}}
	fallbackTarget={{{ [<palette>getindex[tag-background]] }}}
>
<$wikify name="foregroundColor" text="""<$macrocall $name="contrastcolour" target=<<colour>> fallbackTarget=<<fallbackTarget>> colourA=<<colourA>> colourB=<<colourB>>/>""">
<$let backgroundColor=<<colour>>>
<span class="tc-tag-label tc-tag-list-item tc-small-gap-right"
	data-tag-title=<<value>>
	style=`color:$(foregroundColor)$; fill:$(foregroundColor)$; background-color:$(backgroundColor)$;`
>
<$transclude tiddler=<<icon>>/>
<$text text=<<value>>/>
<%if [<readonly>!match[yes]] %>
<$button class="tc-btn-invisible tc-remove-tag-button" style.fill=<<foregroundColor>>
	tooltip=<<removeHint>>
	aria-label=<<removeHint>>
>
<$action-listops $tiddler=<<saveTiddler>> $field=<<field>> $subfilter="-[<value>]"/>
{{$:/core/images/close-button}}
</$button>
<%endif%>
</span>
</$let>
</$wikify>
</$let>
</$let>
\end

\procedure bf-clear-list-state()
<$action-deletetiddler $filter="[<newValueTiddler>] [<newValueInput>] [<newValueSelection>] [<newValueRefresh>] [<newValuePopup>]"/>
\end

<!-- `variable` is mandatory on the guard list: without it the list rebinds
	currentTiddler to the new value, and listops would target that tiddler
	instead of the one being edited. -->
\procedure bf-add-list-actions()
<$let value={{{ [<newValueTiddler>get[text]trim[]] }}}>
<$list filter="[<value>!match[]]" variable="ignore">
<$action-listops $tiddler=<<saveTiddler>> $field=<<field>> $subfilter="[<value>]"/>
</$list>
<<bf-clear-list-state>>
</$let>
\end

\procedure bf-cancel-list-actions()
<%if [<newValueTiddler>has[text]] :else[<newValueInput>has[text]] %>
<<bf-clear-list-state>>
<%else%>
<<cancel-delete-tiddler-actions "cancel">>
<%endif%>
\end

\procedure bf-list-value-field(field)
\whitespace trim
<$let saveTiddler=<<currentTiddler>>
	statePrefix={{{ [[$:/temp/New]addsuffix<field>addsuffix[Value]] }}}
	inputPath={{{ [<statePrefix>addsuffix[/input]] }}}
	selectionPath={{{ [<statePrefix>addsuffix[/selected-item]] }}}
	refreshPath={{{ [<statePrefix>addsuffix[/refresh]] }}}
	popupPath={{{ [[$:/state/popup/bf-]addsuffix<field>addsuffix[-dropdown]] }}}
	promptKey={{{ [[Fields/]addsuffix<field>addsuffix[/Prompt]] }}}
	placeholderKey={{{ [[Fields/]addsuffix<field>addsuffix[/Placeholder]] }}}
	dropdownHintKey={{{ [[Fields/]addsuffix<field>addsuffix[/Dropdown/Hint]] }}}
	dropdownEmptyKey={{{ [[Fields/]addsuffix<field>addsuffix[/Dropdown/Empty]] }}}
	searchFilterField={{{ [<field>addsuffix[-search-filter]] }}}
	ariaLabel={{{ [function[base-fields-lingo-text],<promptKey>trim[:]trim[]] }}}
	placeholderText={{{ [function[base-fields-lingo-text],<placeholderKey>] }}}
	dropdownHint={{{ [function[base-fields-lingo-text],<dropdownHintKey>] }}}
>
<$qualify name="newValueTiddler" title=<<statePrefix>>>
<$qualify name="newValueInput" title=<<inputPath>>>
<$qualify name="newValueSelection" title=<<selectionPath>>>
<$qualify name="newValueRefresh" title=<<refreshPath>>>
<$qualify name="newValuePopup" title=<<popupPath>>>
<!--
	No visible label: the placeholder says what the control is for, and the row has
	only so much width to give. `role`/`aria-label` keep the control named for a
	screen reader.
-->
<span class="bf-list-field" role="group"
	aria-label=<<ariaLabel>>
>
<div class="tc-edit-tags bf-list-box">
<$list filter="[<currentTiddler>get<field>enlist-input[]sort[]]" variable="value" storyview="pop">
<<bf-list-pill field=<<field>> value=<<value>> >>
</$list>
<div class="tc-edit-add-tag">
<div class="tc-edit-add-tag-ui">
<span class="tc-add-tag-name tc-small-gap-right" style={{{ [function[bf-list-placeholder-chars]addprefix[--bf-input-chars: ]] }}}>
<$transclude $variable="keyboard-driven-input"
	tiddler=<<newValueTiddler>> field="text" storeTitle=<<newValueInput>>
	refreshTitle=<<newValueRefresh>> selectionStateTitle=<<newValueSelection>>
	tag="input" default="" class="tc-edit-texteditor tc-popup-handle"
	placeholder=<<placeholderText>>
	focusPopup=<<newValuePopup>> tabindex={{$:/config/EditTabIndex}} cancelPopups="yes"
	configTiddlerFilter="[[$:/plugins/nikorion/base-fields/search-filters]]"
	firstSearchFilterField=<<searchFilterField>>
	inputAcceptActions=<<bf-add-list-actions>>
	inputCancelActions=<<bf-cancel-list-actions>>
/>
</span>
<$button popup=<<newValuePopup>> class="tc-btn-invisible tc-btn-dropdown"
	tooltip=<<dropdownHint>>
	aria-label=<<dropdownHint>>
>
{{$:/core/images/down-arrow}}
</$button>
<span class="tc-add-tag-button tc-small-gap-left">
<$button actions=<<bf-add-list-actions>>>
{{$:/language/EditTemplate/Tags/Add/Button}}
</$button>
</span>
</div>
<div class="tc-block-dropdown-wrapper">
<$reveal state=<<newValuePopup>> type="nomatch" text="" default="">
<$let userInput={{{ [<newValueInput>get[text]] }}}>
<div class="tc-block-dropdown bf-list-dropdown">
<$list filter="[all[tiddlers]!has[draft.of]has<field>each:list-item<field>sort[]search:title<userInput>]" variable="value"
	emptyMessage="""<div class="tc-dropdown-item"><<base-fields-lingo title=<<dropdownEmptyKey>>>></div>"""
>
<$button tag="a" class={{{ [<value>addsuffix[-primaryList]] :except[<newValueSelection>get[text]] :and[then[tc-btn-invisible bf-dropdown-item]else[tc-btn-invisible bf-dropdown-item tc-tag-button-selected]] }}}>
<$action-listops $tiddler=<<saveTiddler>> $field=<<field>> $subfilter="[<value>]"/>
<<bf-clear-list-state>>
<$text text=<<value>>/>
</$button>
</$list>
</div>
</$let>
</$reveal>
</div>
</div>
</div>
</span>
</$qualify>
</$qualify>
</$qualify>
</$qualify>
</$qualify>
</$let>
\end
