title: $:/plugins/nikorion/base-fields/macros/edit-fields
tags: $:/tags/Global

<!-- Controls rendered on the Type row of the edit template. -->

<!-- Choosing the empty option clears the field instead of storing an empty string. -->
\procedure bf-clear-empty-field()
<$list filter="[<currentTiddler>!has<field>]">
<$action-deletefield $field=<<field>>/>
</$list>
\end

<!--
	The same clear button the core offers on Type, for the fields added here —
	always shown, like the core one, so the row keeps a stable shape whether or not
	the field holds a value.
-->
\procedure bf-delete-field-button(field)
\whitespace trim
<$let hintKey={{{ [[Fields/]addsuffix<field>addsuffix[/Delete/Hint]] }}}>
<$button class="tc-btn-invisible tc-btn-icon bf-delete-field"
	tooltip={{{ [function[base-fields-lingo-text],<hintKey>] }}}
	aria-label={{{ [function[base-fields-lingo-text],<hintKey>] }}}
>
{{$:/core/images/delete-button}}
<$action-deletefield $field=<<field>>/>
</$button>
</$let>
\end

<!--
	One entry of a vocabulary dropdown: what the value looks like, and what it means
	as the tooltip. A value shipped without a description simply gets no tooltip.
-->
\procedure bf-vocab-option(field,slug)
\whitespace trim
<option value=<<slug>> title={{{ [function[bf-vocab-hint],<field>,<slug>] }}}><<bf-vocab-item field=<<field>> value=<<slug>> >></option>
\end

<!--
	Why a control is flagged: the role the tiddler now has does not use this field, and
	the tooltip says so by name (a field may carry its own sentence, `Fields/<field>/Stale/Hint`,
	when a list of roles reads better than the current one — `status` does — and
	`Fields/<field>/Stale/NoRole/Hint` for a tiddler that has no role at all) — "Tasks do not use this field — clear it". The role's
	plural comes from the vocabulary strings. A control is only ever flagged on a tiddler
	that has a role, so there is always one to name.
-->
\function bf-stale-with-role(plural)
[function[base-fields-lingo-text],[Fields/Stale/Prefix]] [<plural>] [function[base-fields-lingo-text],[Fields/Stale/Suffix]] +[join[ ]]
\end

<!--
	Single value picked from a controlled vocabulary (role, maturity, status, lifecycle).
	`stale="yes"` marks a control shown only because its field still holds a value the
	tiddler's role no longer accounts for: it gets a red frame and an explanatory tooltip.
-->
\procedure bf-select-field(field,stale)
\whitespace trim
<$let promptKey={{{ [[Fields/]addsuffix<field>addsuffix[/Prompt]] }}}
	placeholderKey={{{ [[Fields/]addsuffix<field>addsuffix[/Placeholder]] }}}
	plural={{{ [<currentTiddler>get[role]!match[]] :map[function[bf-vocab-plural],<currentTiddler>] }}}
	specificKey={{{ [[Fields/]addsuffix<field>addsuffix[/Stale/Hint]] }}}
	specific={{{ [function[base-fields-lingo-text],<specificKey>] }}}
	noRoleKey={{{ [[Fields/]addsuffix<field>addsuffix[/Stale/NoRole/Hint]] }}}
	noRole={{{ [function[base-fields-lingo-text],<noRoleKey>] }}}
	hint={{{ [<plural>match[]then<noRole>!match<noRoleKey>] :else[<specific>!match<specificKey>] :else[function[bf-stale-with-role],<plural>] }}}
	staleHint={{{ [<stale>match[yes]] :map[<hint>] }}}
>
<span class={{{ [[bf-edit-field]] [<stale>match[yes]then[bf-stale]] +[join[ ]] }}} title=<<staleHint>>>
<em class="tc-edit tc-small-gap-right"><<base-fields-lingo title=<<promptKey>> >></em>
<!--
	`default` is not optional: with no value the select widget assigns `undefined`
	to the DOM node, which matches no option at all — the control would go blank
	instead of falling back to the placeholder option below.
-->
<$select tiddler=<<currentTiddler>> field=<<field>> class="tc-edit-texteditor bf-edit-select"
	default="" tabindex={{$:/config/EditTabIndex}} actions=<<bf-clear-empty-field>>
>
<!--
	A `<select>` has no placeholder attribute, so an option plays that part: it is
	what an empty field shows, instead of the first vocabulary value on a tiddler
	that holds no value at all. `hidden` keeps it out of the list once the list is
	open — it stands for nothing to choose — while the browser goes on showing it in
	the closed control, which is all it is there for; `disabled` stops the keyboard
	landing on it. Clearing is the button next to the control. The stylesheet greys
	the control while this option is the one selected.
-->
<option value="" disabled="disabled" hidden="hidden"><<base-fields-lingo title=<<placeholderKey>> >></option>
<!--
	Whatever no group claims comes first, then one heading per group — a vocabulary
	that declares no group simply lists its values, as before.
-->
<$list filter="[function[bf-vocab-ungrouped-values],<field>]" variable="slug">
<<bf-vocab-option field=<<field>> slug=<<slug>> >>
</$list>
<$list filter="[function[bf-vocab-groups],<field>]" variable="group">
<optgroup label={{{ [function[bf-vocab-group-label],<field>,<group>] }}} title={{{ [function[bf-vocab-group-hint],<field>,<group>] }}}>
<$list filter="[function[bf-vocab-group-values],<field>,<group>]" variable="slug">
<<bf-vocab-option field=<<field>> slug=<<slug>> >>
</$list>
</optgroup>
</$list>
</$select>
<<bf-delete-field-button field=<<field>> >>
</span>
</$let>
\end

<!--
	`needs` is a list field whose values come from a controlled vocabulary, several of
	which can hold at once: one checkbox per value, ticked when the value is in the
	list. Ticking adds the slug to the list and unticking removes it, leaving the
	others alone (`listField` mode of the core checkbox widget).
-->

\procedure bf-needs-field(stale)
\whitespace trim
<$let plural={{{ [<currentTiddler>get[role]!match[]] :map[function[bf-vocab-plural],<currentTiddler>] }}}
	hint={{{ [function[bf-stale-with-role],<plural>] }}}
	staleHint={{{ [<stale>match[yes]] :map[<hint>] }}}
>
<span class={{{ [[bf-edit-field bf-needs-field]] [<stale>match[yes]then[bf-stale]] +[join[ ]] }}} title=<<staleHint>>>
<em class="tc-edit tc-small-gap-right"><<base-fields-lingo title="Fields/needs/Prompt">></em>
<$list filter="[function[bf-vocab-values],[needs]]" variable="slug">
<span class="bf-need" title={{{ [<staleHint>!match[]] :else[function[bf-vocab-hint],[needs],<slug>] }}}>
<$checkbox tiddler=<<currentTiddler>> listField="needs" checked=<<slug>>>
<<bf-vocab-item field="needs" value=<<slug>> >>
</$checkbox>
</span>
</$list>
<<bf-delete-field-button field="needs">>
</span>
</$let>
\end

<!--
	A single free value, typed or picked from the values already used in the wiki —
	the same machinery as the tools input and as the core Type control, except that
	the input writes straight into the field instead of feeding a list.
-->

\procedure bf-clear-project-state()
<$action-deletetiddler $filter="[<projectInput>] [<projectSelection>] [<projectRefresh>] [<projectPopup>]"/>
\end

\procedure bf-cancel-project-actions()
<%if [<projectInput>has[text]] %>
<<bf-clear-project-state>>
<%else%>
<<cancel-delete-tiddler-actions "cancel">>
<%endif%>
\end

\procedure bf-project-field()
\whitespace trim
<$let saveTiddler=<<currentTiddler>>
	projectInput=<<qualify "$:/temp/Project/input">>
	projectSelection=<<qualify "$:/temp/Project/selected-item">>
	projectRefresh=<<qualify "$:/temp/Project/refresh">>
	projectPopup=<<qualify "$:/state/popup/bf-project-dropdown">>
>
<span class="bf-edit-field bf-edit-field-project" role="group"
	aria-label={{{ [function[base-fields-lingo-text],[Fields/project/Prompt]trim[:]trim[]] }}}
>
<!-- Labelled like Role, Maturity and Status: same markup — the placeholder inside
	the input says what to type. -->
<em class="tc-edit tc-small-gap-right"><<base-fields-lingo title="Fields/project/Prompt">></em>
<span class="bf-project-control">
<$transclude $variable="keyboard-driven-input"
	tiddler=<<currentTiddler>> field="project" storeTitle=<<projectInput>>
	refreshTitle=<<projectRefresh>> selectionStateTitle=<<projectSelection>>
	tag="input" default="" class="tc-edit-texteditor tc-popup-handle bf-edit-input"
	placeholder=<<base-fields-lingo-text "Fields/project/Placeholder">>
	focusPopup=<<projectPopup>> tabindex={{$:/config/EditTabIndex}} cancelPopups="yes"
	configTiddlerFilter="[[$:/plugins/nikorion/base-fields/search-filters]]"
	firstSearchFilterField="project-search-filter"
	inputCancelActions=<<bf-cancel-project-actions>>
/>
<$button popup=<<projectPopup>> class="tc-btn-invisible tc-btn-dropdown"
	tooltip=<<base-fields-lingo-text "Fields/project/Dropdown/Hint">>
	aria-label=<<base-fields-lingo-text "Fields/project/Dropdown/Hint">>
>
{{$:/core/images/down-arrow}}
</$button>
<div class="tc-block-dropdown-wrapper">
<$reveal state=<<projectPopup>> type="nomatch" text="" default="">
<$let userInput={{{ [<projectInput>get[text]] }}}>
<div class="tc-block-dropdown bf-project-dropdown">
<$list filter="[all[tiddlers]!has[draft.of]has[project]get[project]each:value[]sort[]search:title<userInput>]" variable="proj"
	emptyMessage="""<div class="tc-dropdown-item"><<base-fields-lingo "Fields/project/Dropdown/Empty">></div>"""
>
<$button tag="a" class={{{ [<proj>addsuffix[-primaryList]] :except[<projectSelection>get[text]] :and[then[tc-btn-invisible bf-dropdown-item]else[tc-btn-invisible bf-dropdown-item tc-tag-button-selected]] }}}>
<$action-setfield $tiddler=<<saveTiddler>> $field="project" $value=<<proj>>/>
<$action-deletetiddler $filter="[<projectInput>] [<projectSelection>] [<projectPopup>]"/>
<!-- The input keeps showing what was typed unless it is told to re-read the field:
	an edit-text widget leaves a focused element alone so as not to clobber typing. -->
<$action-setfield $tiddler=<<projectRefresh>> text="yes"/>
<$text text=<<proj>>/>
</$button>
</$list>
</div>
</$let>
</$reveal>
</div>
</span>
<<bf-delete-field-button field="project">>
</span>
</$let>
\end

<!--
	`tools` is a list field, edited like tags: pills plus an input completing on the
	values already used in `tools` elsewhere in the wiki.

	It deliberately does //not// call the core `tag-picker` macro. That macro
	hardcodes the tags placeholder (`$:/language/EditTemplate/Tags/Add/Placeholder`)
	and reuses the tag input state the edit template defines once for the whole
	form, so the two pickers would fight over a single input — and a half-typed tool
	name would be added as a //tag// by the save-tiddler shortcut. Driving
	`keyboard-driven-input` directly — the very macro `tag-picker` and the core Type
	control are built on — keeps the same keyboard behaviour (Enter to add, up/down
	through the suggestions, Escape to clear) while owning the placeholder and the
	state tiddlers.
-->

<!--
	A tool pill, rendered exactly like a tag pill: same classes, same per-value
	colour cascade (`$:/tags/TiddlerColourFilter`), same contrast-computed
	foreground, same icon cascade. The core equivalent lives in
	`$:/core/ui/EditTemplate/tags` as the local procedures `tag-body`/`tag-body-inner`,
	which are not reachable from outside that tiddler — hence this copy rather than a
	call. Keep it in step with the core version when upgrading TiddlyWiki.
-->
\procedure bf-tool-pill(tool)
\whitespace trim
<$let palette={{$:/palette}}>
<!--
	Same colour cascade as a tag pill, with one difference: where a tag falls back to
	the palette's `tag-background`, a tool falls back to a colour of its own, so the
	two kinds of pill stay told apart at a glance on a tiddler carrying both. The
	fallback is a configuration tiddler, not a literal, so a wiki can pick another.
-->
<$let colour={{{ [<tool>] :cascade[all[shadows+tiddlers]tag[$:/tags/TiddlerColourFilter]!is[draft]get[text]] :and[!match[]] :else[{$:/config/nikorion/base-fields/tools/Colour}] }}}
	icon={{{ [<tool>] :cascade[all[shadows+tiddlers]tag[$:/tags/TiddlerIconFilter]!is[draft]get[text]] }}}
	colourA={{{ [<palette>getindex[foreground]] }}}
	colourB={{{ [<palette>getindex[background]] }}}
	fallbackTarget={{{ [<palette>getindex[tag-background]] }}}
>
<$wikify name="foregroundColor" text="""<$macrocall $name="contrastcolour" target=<<colour>> fallbackTarget=<<fallbackTarget>> colourA=<<colourA>> colourB=<<colourB>>/>""">
<$let backgroundColor=<<colour>>>
<span class="tc-tag-label tc-tag-list-item tc-small-gap-right"
	data-tag-title=<<tool>>
	style=`color:$(foregroundColor)$; fill:$(foregroundColor)$; background-color:$(backgroundColor)$;`
>
<$transclude tiddler=<<icon>>/>
<$text text=<<tool>>/>
<$button class="tc-btn-invisible tc-remove-tag-button" style.fill=<<foregroundColor>>
	tooltip=<<base-fields-lingo-text "Fields/tools/Remove/Hint">>
	aria-label=<<base-fields-lingo-text "Fields/tools/Remove/Hint">>
>
<$action-listops $tiddler=<<saveTiddler>> $field="tools" $subfilter="-[<tool>]"/>
{{$:/core/images/close-button}}
</$button>
</span>
</$let>
</$wikify>
</$let>
</$let>
\end

\procedure bf-clear-tool-state()
<$action-deletetiddler $filter="[<toolName>] [<toolInput>] [<toolSelection>] [<toolRefresh>] [<toolPopup>]"/>
\end

<!-- `variable` is mandatory on the guard list: without it the list rebinds
	currentTiddler to the tool name, and listops would target that tiddler
	instead of the one being edited. -->
\procedure bf-add-tool-actions()
<$let tool={{{ [<toolName>get[text]trim[]] }}}>
<$list filter="[<tool>!match[]]" variable="ignore">
<$action-listops $tiddler=<<saveTiddler>> $field="tools" $subfilter="[<tool>]"/>
</$list>
<<bf-clear-tool-state>>
</$let>
\end

\procedure bf-cancel-tool-actions()
<%if [<toolName>has[text]] :else[<toolInput>has[text]] %>
<<bf-clear-tool-state>>
<%else%>
<<cancel-delete-tiddler-actions "cancel">>
<%endif%>
\end

\procedure bf-tools-field()
\whitespace trim
<$let saveTiddler=<<currentTiddler>>
	toolName=<<qualify "$:/temp/NewToolName">>
	toolInput=<<qualify "$:/temp/NewToolName/input">>
	toolSelection=<<qualify "$:/temp/NewToolName/selected-item">>
	toolRefresh=<<qualify "$:/temp/NewToolName/refresh">>
	toolPopup=<<qualify "$:/state/popup/bf-tools-dropdown">>
>
<!--
	No visible label: the placeholder says what the control is for, and the row has
	only so much width to give. `role`/`aria-label` keep the control named for a
	screen reader.
-->
<span class="bf-tools-field" role="group"
	aria-label={{{ [function[base-fields-lingo-text],[Fields/tools/Prompt]trim[:]trim[]] }}}
>
<div class="tc-edit-tags bf-tools-box">
<$list filter="[<currentTiddler>get[tools]enlist-input[]sort[]]" variable="tool" storyview="pop">
<<bf-tool-pill tool=<<tool>> >>
</$list>
<div class="tc-edit-add-tag">
<div class="tc-edit-add-tag-ui">
<span class="tc-add-tag-name tc-small-gap-right">
<$transclude $variable="keyboard-driven-input"
	tiddler=<<toolName>> field="text" storeTitle=<<toolInput>>
	refreshTitle=<<toolRefresh>> selectionStateTitle=<<toolSelection>>
	tag="input" default="" class="tc-edit-texteditor tc-popup-handle"
	placeholder=<<base-fields-lingo-text "Fields/tools/Placeholder">>
	focusPopup=<<toolPopup>> tabindex={{$:/config/EditTabIndex}} cancelPopups="yes"
	configTiddlerFilter="[[$:/plugins/nikorion/base-fields/search-filters]]"
	firstSearchFilterField="tools-search-filter"
	inputAcceptActions=<<bf-add-tool-actions>>
	inputCancelActions=<<bf-cancel-tool-actions>>
/>
</span>
<$button popup=<<toolPopup>> class="tc-btn-invisible tc-btn-dropdown"
	tooltip=<<base-fields-lingo-text "Fields/tools/Dropdown/Hint">>
	aria-label=<<base-fields-lingo-text "Fields/tools/Dropdown/Hint">>
>
{{$:/core/images/down-arrow}}
</$button>
<span class="tc-add-tag-button tc-small-gap-left">
<$button actions=<<bf-add-tool-actions>>>
{{$:/language/EditTemplate/Tags/Add/Button}}
</$button>
</span>
</div>
<div class="tc-block-dropdown-wrapper">
<$reveal state=<<toolPopup>> type="nomatch" text="" default="">
<$let userInput={{{ [<toolInput>get[text]] }}}>
<div class="tc-block-dropdown bf-tools-dropdown">
<$list filter="[all[tiddlers]!has[draft.of]has[tools]each:list-item[tools]sort[]search:title<userInput>]" variable="tool"
	emptyMessage="""<div class="tc-dropdown-item"><<base-fields-lingo "Fields/tools/Dropdown/Empty">></div>"""
>
<$button tag="a" class={{{ [<tool>addsuffix[-primaryList]] :except[<toolSelection>get[text]] :and[then[tc-btn-invisible bf-dropdown-item]else[tc-btn-invisible bf-dropdown-item tc-tag-button-selected]] }}}>
<$action-listops $tiddler=<<saveTiddler>> $field="tools" $subfilter="[<tool>]"/>
<<bf-clear-tool-state>>
<$text text=<<tool>>/>
</$button>
</$list>
</div>
</$let>
</$reveal>
</div>
</div>
</div>
</span>
</$let>
\end
